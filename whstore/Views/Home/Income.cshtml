<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WH Agent Dashboard</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #090909;
            --card-bg: #151515;
            --accent-green: #00ff88;
            --accent-blue: #00d4ff;
            --text-main: #ffffff;
            --text-muted: #a0a0a0;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding-bottom: 50px;
        }

        .card-dark {
            background: var(--card-bg);
            border: 1px solid #222;
            border-radius: 15px;
            overflow: hidden;
        }

        /* পোস্টের মেইন টেক্সট স্টাইল (যাতে সহজে পড়া যায়) */
        .post-body-text {
            font-size: 1.15rem; /* বড় ফন্ট */
            line-height: 1.6; /* লাইনের মাঝে গ্যাপ */
            color: #f0f0f0;
            padding: 10px 0;
            word-wrap: break-word;
        }

        .post-header {
            border-bottom: 1px solid #222;
            padding-bottom: 10px;
            margin-bottom: 10px;
        }

        .agent-label {
            font-weight: bold;
            color: var(--accent-green);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .income-badge {
            background: rgba(0, 255, 136, 0.15);
            color: var(--accent-green);
            padding: 5px 12px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 1rem;
            border: 1px solid rgba(0, 255, 136, 0.3);
        }

        .form-control {
            background: #1e1e1e !important;
            border: 1px solid #333 !important;
            color: white !important;
            font-size: 1rem;
        }

        /* ছবির গ্রিড স্টাইল */
        .post-images-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 8px;
            margin-top: 15px;
        }
        .post-images-grid img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #333;
        }

        .support-btn {
            background: #222;
            border: none;
            color: var(--text-muted);
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            transition: 0.3s;
        }
        .support-btn:hover {
            background: var(--accent-green);
            color: black;
        }

        .timestamp {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        #imagePreview {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }
        .preview-box {
            width: 60px; height: 60px; border-radius: 5px; overflow: hidden; border: 1px solid var(--accent-green);
        }
        .preview-box img { width: 100%; height: 100%; object-fit: cover; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-black py-3 mb-4 border-bottom border-secondary">
    <div class="container" style="max-width: 700px;">
        <span class="navbar-brand fw-bold text-success"><i class="bi bi-cpu"></i> WH AGENT STORE</span>
    </div>
</nav>

<div class="container" style="max-width: 700px;">

    <!-- ইনপুট কার্ড -->
    <div class="card card-dark p-4 mb-4 shadow">
        <form id="agentPostForm">
            <textarea id="postText" class="form-control mb-3" rows="3" placeholder="আজকের কাজের বিস্তারিত এখানে লিখুন..." required></textarea>
            
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center">
                    <label for="imgUpload" class="me-3" style="cursor: pointer; color: var(--accent-blue); font-size: 1.6rem;">
                        <i class="bi bi-images"></i>
                    </label>
                    <input type="file" id="imgUpload" multiple accept="image/*" style="display: none;">

                    <div class="input-group input-group-sm" style="max-width: 130px;">
                        <span class="input-group-text bg-dark border-secondary text-success">৳</span>
                        <input type="number" id="incomeAmount" class="form-control" placeholder="আয়">
                    </div>
                </div>
                <button type="submit" class="btn btn-success px-4 fw-bold">Post Update</button>
            </div>
            <div id="imagePreview"></div>
        </form>
    </div>

    <!-- পোস্ট ফিড -->
    <div id="agentFeed"></div>

</div>

<script>
    const agentPostForm = document.getElementById('agentPostForm');
    const postText = document.getElementById('postText');
    const incomeAmount = document.getElementById('incomeAmount');
    const imgUpload = document.getElementById('imgUpload');
    const imagePreview = document.getElementById('imagePreview');
    const agentFeed = document.getElementById('agentFeed');

    let postImages = [];

    imgUpload.addEventListener('change', function(e) {
        const files = Array.from(e.target.files);
        files.forEach(file => {
            const reader = new FileReader();
            reader.onload = function(ev) {
                postImages.push(ev.target.result);
                const div = document.createElement('div');
                div.className = 'preview-box';
                div.innerHTML = `<img src="${ev.target.result}">`;
                imagePreview.appendChild(div);
            }
            reader.readAsDataURL(file);
        });
    });

    agentPostForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const postData = {
            id: Date.now(),
            text: postText.value,
            income: incomeAmount.value || "0",
            images: [...postImages],
            time: new Date().toLocaleString('bn-BD'),
            supports: 0
        };
        savePost(postData);
        renderPosts();
        agentPostForm.reset();
        postImages = [];
        imagePreview.innerHTML = '';
    });

    function savePost(post) {
        let posts = JSON.parse(localStorage.getItem('wh_v2_posts') || '[]');
        posts.unshift(post);
        localStorage.setItem('wh_v2_posts', JSON.stringify(posts));
    }

    function renderPosts() {
        const posts = JSON.parse(localStorage.getItem('wh_v2_posts') || '[]');
        agentFeed.innerHTML = '';

        posts.forEach(post => {
            const div = document.createElement('div');
            div.className = 'card card-dark p-4 mb-3 shadow-sm';
            
            let imgHtml = '';
            if(post.images.length > 0) {
                imgHtml = '<div class="post-images-grid">';
                post.images.forEach(img => imgHtml += `<img src="${img}" onclick="window.open('${img}')">`);
                imgHtml += '</div>';
            }

            div.innerHTML = `
                <div class="post-header d-flex justify-content-between align-items-center">
                    <div class="agent-label"><i class="bi bi-person-badge"></i> AGENT UPDATE</div>
                    ${post.income > 0 ? `<div class="income-badge">৳ ${post.income}</div>` : ''}
                </div>
                
                <!-- পোস্টের মূল লেখা এখানে -->
                <div class="post-body-text">
                    ${post.text.replace(/\n/g, '<br>')}
                </div>

                ${imgHtml}

                <div class="mt-3 pt-3 border-top border-secondary d-flex justify-content-between align-items-center">
                    <button class="support-btn" onclick="addSupport(${post.id})">
                        <i class="bi bi-heart-fill me-1"></i> সাপোর্ট (${post.supports})
                    </button>
                    <div class="text-end">
                        <div class="timestamp">${post.time}</div>
                        <i class="bi bi-trash3 text-danger mt-1 d-inline-block" style="cursor:pointer" onclick="deletePost(${post.id})"></i>
                    </div>
                </div>
            `;
            agentFeed.appendChild(div);
        });
    }

    window.addSupport = function(id) {
        let posts = JSON.parse(localStorage.getItem('wh_v2_posts'));
        posts = posts.map(p => { if(p.id === id) p.supports++; return p; });
        localStorage.setItem('wh_v2_posts', JSON.stringify(posts));
        renderPosts();
    };

    window.deletePost = function(id) {
        if(confirm('মুছে ফেলতে চান?')) {
            let posts = JSON.parse(localStorage.getItem('wh_v2_posts'));
            posts = posts.filter(p => p.id !== id);
            localStorage.setItem('wh_v2_posts', JSON.stringify(posts));
            renderPosts();
        }
    }

    renderPosts();
</script>

</body>
</html>
