<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WH-STORE</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/whstore.styles.css" asp-append-version="true" />

    <style>
        body {
            background-color: #000 !important;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        .navbar {
            background-color: #050505 !important;
            border-bottom: 1px solid #1a1a1a !important;
            padding: 0.6rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            appsettings .json color: #0dcaf0 !important;
            font-size: 1.3rem;
            font-weight: 700;
        }

        .nav-link {
            color: #999 !important;
            font-size: 0.85rem;
            text-transform: uppercase;
            font-weight: 600;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: 0.3s;
        }

        .nav-link:hover, .nav-link.active {
            color: #0dcaf0 !important;
            background: rgba(13, 202, 240, 0.1);
        }

        .custom-search-group {
            background: rgba(13, 202, 240, 0.08);
            border: 1px solid rgba(13, 202, 240, 0.25);
            border-radius: 50px;
            padding: 3px 12px;
            display: flex;
            align-items: center;
            width: 280px;
        }

        .search-input {
            background: transparent !important;
            border: none !important;
            color: white !important;
            font-size: 0.85rem;
            padding: 6px 10px;
        }

        .search-btn {
            background: transparent !important;
            border: none !important;
            color: #0dcaf0 !important;
            cursor: pointer;
        }

        @@media (max-width: 991px) {
            .custom-search-group {
                width: 100%;
                margin-top: 10px;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-dark navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    WH-STORE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @{
                            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        }
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Privacy" ? "active" : "")" asp-controller="Home" asp-action="Privacy">Admin</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Embed" ? "active" : "")" asp-controller="Home" asp-action="Embed">Embed</a>
                        </li>
                    </ul>
                    <form class="d-flex" asp-controller="Home" asp-action="Index" method="get">
                        <div class="custom-search-group">
                            <input class="form-control search-input" type="search" name="searchString" placeholder="Search..." value="@ViewData["CurrentFilter"]" autocomplete="off">
                            <button class="search-btn" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>