<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WH-STORE | কর্মসংস্থান ও ইনকাম বোর্ড</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root { --neon-green: #00ff88; --job-blue: #00d4ff; --dark-card: #121212; }
        body { background-color: #050505; color: white; font-family: 'Segoe UI', sans-serif; padding-bottom: 50px; }
        
        .card-custom { background: var(--dark-card); border: 1px solid #222; border-radius: 15px; margin-bottom: 20px; }
        
        /* ইন্সট্রাকশন বক্স স্টাইল */
        .guide-box {
            background: linear-gradient(145deg, #0f2027, #203a43);
            border: 1px solid var(--job-blue);
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 25px;
            position: relative;
        }
        .guide-box h6 { color: var(--job-blue); font-weight: bold; }
        .guide-list { font-size: 0.9rem; color: #ccc; padding-left: 20px; margin-bottom: 0; }
        .guide-list li { margin-bottom: 5px; }

        .nav-tabs .nav-link { color: #888; border: none; font-weight: 600; }
        .nav-tabs .nav-link.active { color: var(--neon-green); background: none; border-bottom: 3px solid var(--neon-green); }

        .category-icon { width: 40px; height: 40px; background: rgba(0, 212, 255, 0.1); color: var(--job-blue); display: flex; align-items: center; justify-content: center; border-radius: 10px; font-size: 1.2rem; }
        .job-card { border-left: 5px solid var(--job-blue); transition: 0.3s; }
        .price-tag { color: var(--neon-green); font-weight: bold; }
        .btn-post { background: var(--neon-green); color: black; font-weight: bold; border-radius: 10px; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-black border-bottom border-secondary sticky-top mb-4">
    <div class="container" style="max-width: 800px;">
        <span class="navbar-brand fw-bold text-success"><i class="bi bi-shop-window"></i> WH-STORE</span>
        <img src="https://via.placeholder.com/40" class="rounded-circle border border-success" width="40" height="40">
    </div>
</nav>

<div class="container" style="max-width: 800px;">

    <!-- 📢 নতুন নির্দেশিকা বক্স (Updated Instruction Box) -->
    <div class="guide-box shadow-sm animate__animated animate__fadeIn">
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-info-circle-fill text-info fs-4 me-2"></i>
            <h6>আপনি এখানে কী কী করতে পারবেন?</h6>
        </div>
        <ul class="guide-list">
            <li><strong>কাজের বিজ্ঞাপন দিন:</strong> আপনার বাড়ির কাজের জন্য (পেইন্টার, প্লাম্বার, ড্রাইভার ইত্যাদি) লোক লাগবে? 'কাজের বোর্ড' থেকে বিজ্ঞাপন দিন।</li>
            <li><strong>কাজের আপডেট দিন:</strong> আপনি কি আজ কোনো কাজ করেছেন? কত টাকা আয় করলেন? সেটি 'ইনকাম আপডেট' থেকে ছবিসহ পোস্ট করুন।</li>
            <li><strong>১২টি ক্যাটাগরি:</strong> রঙের মিস্ত্রি থেকে শুরু করে লোডার—যেকোনো ক্যাটাগরিতে কাজ খোঁজা বা দেওয়ার সুবিধা।</li>
            <li><strong>বেকারত্ব দূর করুন:</strong> আপনি কাজ দিয়ে বা কাজ করে একে অপরকে সাহায্য করুন।</li>
        </ul>
    </div>
    
    <!-- Tab Navigation -->
    <ul class="nav nav-tabs mb-4 justify-content-center" id="dashboardTabs">
        <li class="nav-item">
            <button class="nav-link active" id="job-board-tab" data-bs-toggle="tab" data-bs-target="#jobBoard"><i class="bi bi-briefcase"></i> কাজের বোর্ড</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="income-feed-tab" data-bs-toggle="tab" data-bs-target="#incomeFeed"><i class="bi bi-graph-up-arrow"></i> ইনকাম আপডেট</button>
        </li>
    </ul>

    <div class="tab-content">
        
        <!-- ১. কাজের বোর্ড সেকশন -->
        <div class="tab-pane fade show active" id="jobBoard">
            <div class="card card-custom p-3 text-center">
                <h6 class="mb-2 text-info">বাড়ির কাজের জন্য দক্ষ লোক খুঁজুন</h6>
                <button class="btn btn-outline-info btn-sm fw-bold w-50 mx-auto" data-bs-toggle="modal" data-bs-target="#postJobModal">
                    <i class="bi bi-plus-circle"></i> কাজের বিজ্ঞাপন দিন
                </button>
            </div>

            <div id="jobListDisplay">
                <!-- নমুনা কাজ -->
                <div class="card card-custom p-4 job-card">
                    <div class="d-flex gap-3">
                        <div class="category-icon"><i class="bi bi-lightning-charge"></i></div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <h5 class="mb-0">ইলেকট্রিক মিস্ত্রি লাগবে</h5>
                                <span class="price-tag">৳ ৮০০</span>
                            </div>
                            <p class="text-white-50 small mb-2">রাজশাহী সিটি</p>
                            <p class="small">বাসার মেইন বোর্ডে সমস্যা, আজকেই ঠিক করতে হবে।</p>
                            <button class="btn btn-sm btn-info text-white mt-2">কাজটি নিতে চাই</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ২. ইনকাম আপডেট সেকশন -->
        <div class="tab-pane fade" id="incomeFeed">
            <div class="card card-custom p-4">
                <h6 class="text-success mb-3">আজকের কাজের সাকসেস শেয়ার করুন</h6>
                <textarea class="form-control bg-dark text-white border-secondary mb-3" rows="3" placeholder="আজকের কাজের অভিজ্ঞতা লিখুন..."></textarea>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex gap-3 fs-4 text-info">
                        <i class="bi bi-camera-fill" style="cursor:pointer"></i>
                        <div class="input-group input-group-sm" style="max-width: 120px;">
                            <span class="input-group-text bg-black text-success border-secondary">৳</span>
                            <input type="number" class="form-control bg-dark text-white border-secondary" placeholder="আয়">
                        </div>
                    </div>
                    <button class="btn btn-post px-4">Post Update</button>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal: নতুন কাজের বিজ্ঞাপন (১২টি ক্যাটাগরি) -->
<div class="modal fade" id="postJobModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark border-secondary text-white">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-info">কাজের বিজ্ঞাপন দিন</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <select class="form-select bg-black text-white border-secondary mb-3">
            <option selected disabled>কাজের ক্যাটাগরি বেছে নিন</option>
            <option>🎨 রঙের মিস্ত্রি / পেইন্টার</option>
            <option>⚡ ইলেকট্রিক মিস্ত্রি</option>
            <option>🧱 রাজমিস্ত্রি + হেল্পার</option>
            <option>🚰 প্লাম্বার / স্যানিটারি</option>
            <option>🧹 ক্লিনার (বাসা/অফিস)</option>
            <option>🪑 কার্পেন্টার (ফার্নিচার)</option>
            <option>❄️ AC ও ফ্রিজ মিস্ত্রি</option>
            <option>🔥 ওয়েল্ডিং মিস্ত্রি</option>
            <option>👩‍🍳 গৃহকর্মী / বুয়া</option>
            <option>🌱 মালি (ছাদ বাগান)</option>
            <option>🚗 ড্রাইভার</option>
            <option>📦 লোডার / বাসা শিফটিং</option>
        </select>
        <input type="text" class="form-control bg-black text-white mb-3" placeholder="কাজের নাম">
        <textarea class="form-control bg-black text-white mb-3" rows="3" placeholder="কাজের বিস্তারিত..."></textarea>
        <div class="row g-2">
            <div class="col-6"><input type="text" class="form-control bg-black text-white" placeholder="লোকেশন"></div>
            <div class="col-6"><input type="number" class="form-control bg-black text-white" placeholder="বাজেট ৳"></div>
        </div>
      </div>
      <div class="modal-footer border-secondary">
        <button class="btn btn-info text-white fw-bold w-100">বিজ্ঞাপনটি পোস্ট করুন</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
