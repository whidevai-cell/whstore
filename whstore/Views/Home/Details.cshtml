@model whstore.Models.ProductDetailsViewModel

@{
    if (Model?.Product == null)
    {
        <div class="container py-5 text-center">
            <h3 class="text-muted">Product not found</h3>
            <a href="/" class="btn btn-outline-info mt-3">Back to Home</a>
        </div>
        return;
    }

    ViewData["Title"] = "Product Details - " + (Model.Product.Title ?? "Item");
    var imageSrc = !string.IsNullOrEmpty(Model.Product.ImageUrl) ? Model.Product.ImageUrl : "https://via.placeholder.com/600x400?text=No+Image";
    var buyLink = !string.IsNullOrEmpty(Model.Product.AffiliateLink) ? Model.Product.AffiliateLink : "#";
}

<style>
    body {
        background-color: #000;
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
    }

    .details-container {
        background: #0a0a0a;
        border: 1px solid #222;
        border-radius: 15px;
        padding: 30px;
        margin-top: 50px;
        margin-bottom: 50px;
    }

    .product-img {
        max-width: 100%;
        border-radius: 10px;
        border: 1px solid #333;
        background: #fff;
        padding: 10px;
        display: block;
        margin: 0 auto;
    }

    .price-text {
        color: #0dcaf0;
        font-size: 2.2rem;
        font-weight: bold;
    }

    .old-price {
        text-decoration: line-through;
        color: #666;
        margin-left: 10px;
        font-size: 1.2rem;
    }

    .btn-buy {
        background: linear-gradient(45deg, #0dcaf0, #007bff);
        color: #fff;
        font-weight: bold;
        padding: 15px 35px;
        border-radius: 50px;
        text-decoration: none;
        display: inline-block;
        transition: 0.3s;
        width: 100%;
        text-align: center;
    }

        .btn-buy:hover {
            transform: translateY(-3px);
            color: #fff;
            box-shadow: 0 5px 15px rgba(13, 202, 240, 0.4);
        }

    .desc-box {
        background: #111;
        border-left: 4px solid #0dcaf0;
        padding: 20px;
        border-radius: 5px;
        margin-top: 25px;
        color: #ddd;
        line-height: 1.6;
    }

    .meta-item {
        background: #161616;
        padding: 10px 15px;
        border-radius: 8px;
        margin-right: 10px;
        display: inline-block;
        border: 1px solid #222;
    }

    .product-card {
        transition: all 0.3s ease;
        cursor: pointer;
        border-radius: 12px !important;
        border: 1px solid #1a1a1a !important;
        background-color: #050505 !important;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .product-card:hover {
            transform: translateY(-5px);
            border-color: #0dcaf0 !important;
            box-shadow: 0 8px 20px rgba(13, 202, 240, 0.15) !important;
        }

    .card-img-container {
        background: #fff;
        padding: 10px;
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .card-img-top {
        max-height: 100%;
        width: auto;
        object-fit: contain;
    }
</style>

<div class="container">
    <div class="details-container">
        <div class="row">
            <div class="col-md-5 mb-4">
                <img src="@imageSrc" class="product-img shadow-lg" alt="@Model.Product.Title">
            </div>
            <div class="col-md-7">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2" style="background:transparent;">
                        <li class="breadcrumb-item"><a href="/" class="text-info text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item active text-muted">Details</li>
                    </ol>
                </nav>

                <h1 class="fw-bold mb-3">@Model.Product.Title</h1>

                <div class="mb-4">
                    <span class="price-text">৳ @Model.Product.Price</span>

                    @if (!string.IsNullOrEmpty(Model.Product.OriginalPrice) && Model.Product.OriginalPrice != "0")
                    {
                        <span class="old-price">৳ @Model.Product.OriginalPrice</span>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <div class="meta-item">
                        <small class="text-muted d-block">Store</small>
                        <span class="text-info fw-bold">@(Model.Product.StoreName ?? "Global")</span>
                    </div>
                    <div class="meta-item">
                        <small class="text-muted d-block">Category</small>
                        <span class="text-white">@(Model.Product.Category ?? "General")</span>
                    </div>
                </div>

                <div class="desc-box">
                    <h5 class="text-info fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Product Description</h5>
                    <p>@(string.IsNullOrEmpty(Model.Product.Description) ? "No detailed description available for this item." : Model.Product.Description)</p>
                </div>

                <div class="mt-5">
                    @if (buyLink != "#")
                    {
                        <a href="@buyLink" target="_blank" class="btn-buy shadow">
                            <i class="bi bi-bag-check-fill me-2"></i> GET THIS PRODUCT NOW
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100" disabled>LINK UNAVAILABLE</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products Section -->
    <div class="mt-5">
        <h3 class="text-light mb-4">Related Products</h3>
        <div id="related-products-container" class="row g-2 g-md-3">
            @await Html.PartialAsync("_ProductCardPartial", Model.RelatedProducts)
        </div>
    </div>
    <div id="loading-spinner" class="text-center" style="display: none;">
        <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

</div>


<script>
    let page = 2; // Start loading from the second page
    let isLoading = false;
    const loadingSpinner = document.getElementById('loading-spinner');
    const container = document.getElementById('related-products-container');

    window.addEventListener('scroll', () => {
        if (isLoading) return;

        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 500) {
            loadMoreProducts();
        }
    });

    async function loadMoreProducts() {
        isLoading = true;
        if (loadingSpinner) loadingSpinner.style.display = 'block';

        try {
            const response = await fetch(`/Home/LoadMoreProducts?page=${page}`);
            if (response.ok) {
                const newProductsHtml = await response.text();
                if (newProductsHtml.trim().length > 0) {
                    container.insertAdjacentHTML('beforeend', newProductsHtml);
                    page++;
                } else {
                    // No more products to load, maybe hide spinner or show a message
                    if (loadingSpinner) loadingSpinner.style.display = 'none';
                    window.removeEventListener('scroll', loadMoreProducts); // Optional: stop listening
                }
            }
        } catch (error) {
            console.error("Failed to load more products:", error);
            // Optionally handle error display to the user
        } finally {
            isLoading = false;
            if (loadingSpinner) loadingSpinner.style.display = 'none';
        }
    }
</script>
