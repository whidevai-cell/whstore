@{
    ViewData["Title"] = "Income Dashboard";
}

<div class="container mt-5" style="max-width: 700px;">
    <div class="text-center mb-4">
        <h2 class="text-white">📝 Income Dashboard</h2>
        <p class="text-white-50">আপনার আয়-ব্যয়ের হিসাব ও ডেইলি আপডেট এখানে পোস্ট করুন</p>
    </div>

    <div class="card p-4 mb-4" style="background: #1a1a1a; border-radius: 15px; border: 1px solid #333;">
        <div class="card-body p-0">
            <h5 class="mb-3 text-info"><i class="bi bi-pencil-square"></i> আজকের আপডেট লিখুন</h5>
            
            <form asp-action="CreatePost" asp-controller="Home" method="post">
                <div class="mb-3">
                    <textarea name="content" class="form-control text-white" rows="3" 
                              style="background: #252525; border: 1px solid #444; border-radius: 10px;" 
                              placeholder="ফেসবুকের মতো কিছু লিখুন..."></textarea>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-4" style="border-radius: 8px;">Post</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <div class="card p-4" style="background: #1a1a1a; border-radius: 15px; border: 1px solid #333;">
                <h5 style="color: #ff4d4d;">খুব শীঘ্রই আসছে...</h5>
                <p style="color: #ccc;">আমরা দেশের মানুষের সুবিধার্থে এই ফ্রি সার্ভিসের ফিচারগুলো ডেভেলপ করছি।</p>
            </div>
        </div>
    </div>
</div>