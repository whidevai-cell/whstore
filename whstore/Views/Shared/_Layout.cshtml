<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WH-STORE</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/whstore.styles.css" asp-append-version="true" />
    <!-- ব্রাউজার ট্যাবের আইকনটিও default-product.png তে আপডেট করে দেওয়া হলো -->
    <link rel="icon" href="~/images/default-product.png" type="image/png" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav id="main-nav" class="navbar navbar-dark navbar-expand-lg fixed-top">
            <div class="container-fluid px-0">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <!-- লোগো ইমেজ পাথ এবং টেক্সট আপনার চাহিদা অনুযায়ী ফিক্সড -->
                    <img src="~/images/default-product.png" alt="Logo" style="height: 35px; width: auto; margin-right: 8px; border-radius: 4px;" />
                    WH-STORE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold" asp-controller="Home" asp-action="Video">Video</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold" asp-controller="Home" asp-action="Income">Income</a>
                        </li>
                    </ul>

                    <form class="d-flex me-3" asp-controller="Home" asp-action="Index" method="get">
                        <div class="custom-search-group">
                            <input class="form-control search-input" type="search" name="searchString" placeholder="Search..." value="@ViewData["CurrentFilter"]" autocomplete="off">
                            <button class="search-btn" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <div class="d-flex align-items-center gap-2 me-2">
                        <a class="btn btn-outline-light btn-sm fw-bold px-2 py-1" style="border-radius: 6px;" asp-controller="Home" asp-action="Privacy">
                            <i class="bi bi-shield-lock me-1"></i>Admin
                        </a>

                        <a class="btn btn-outline-info btn-sm fw-bold px-2 py-1" style="border-radius: 6px;" asp-controller="ProductSync" asp-action="Index">
                            <i class="bi bi-code-slash me-1"></i>Embed
                        </a>
                    </div>

                    <div class="nav-item dropdown">
                        <a class="nav-link" href="#" id="settingsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-gear fs-5 text-info"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end glass-dropdown p-2" aria-labelledby="settingsDropdown" style="min-width: 200px;">

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li class="px-2 py-1 d-flex align-items-center gap-2 text-white-50 fs-7">
                                    @{
                                        var userImage = User.FindFirst("urn:google:picture")?.Value ?? User.FindFirst("picture")?.Value;
                                        var userName = User.Identity.Name ?? "User";
                                    }
                                    @if (!string.IsNullOrEmpty(userImage))
                                    {
                                        <img src="@userImage" alt="Profile" class="rounded-circle" style="width: 26px; height: 26px; object-fit: cover;" referrerpolicy="no-referrer" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle text-info fs-5"></i>
                                    }
                                    <span class="text-truncate fw-bold text-white" style="max-width: 130px;">Hi, @userName!</span>
                                </li>
                                <li><hr class="dropdown-divider" style="background-color: #444;"></li>

                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 text-white py-2" asp-controller="Home" asp-action="Privacy">
                                        <i class="bi bi-bag-plus text-success fs-6"></i> Upload Product
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 text-white py-2" href="#" data-bs-toggle="modal" data-bs-target="#embedModal">
                                        <i class="bi bi-plus-circle text-danger fs-6"></i> Add New Video
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 text-white py-2" asp-controller="Home" asp-action="Income">
                                        <i class="bi bi-pencil-square text-info fs-6"></i> Create Income Post
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider" style="background-color: #444;"></li>
                                <li>
                                    <a class="dropdown-item text-danger d-flex align-items-center gap-2 py-2" asp-controller="Home" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item text-primary d-flex align-items-center gap-2 py-2" asp-controller="Home" asp-action="Login">
                                        <i class="bi bi-google"></i> Login with Google
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid py-4 my-4 glassmorphism-panel rounded-3">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="embedModal" tabindex="-1" role="dialog" aria-labelledby="embedModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" style="background: #1a1a1a; border-radius: 20px; border: 1px solid #333; color:white;">
                <div class="modal-header" style="border-bottom: 1px solid #333;">
                    <h5 class="modal-title" id="embedModalLabel" style="color: #ff4d4d;">🎬 Add New Video</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="Create" asp-controller="Home" method="post" id="embedForm">
                        <div class="mb-3">
                            <input type="text" name="Title" id="videoTitle" class="form-control" style="background: #222; border: 1px solid #444; color: #fff; padding: 12px; border-radius: 10px;" placeholder="🎬 Video Title দিন" autocomplete="off">
                        </div>
                        <div class="input-group">
                            <input type="url" name="EmbedUrl" id="videoUrl" class="form-control" required style="background: #222; border: 1px solid #444; color: #fff; padding: 12px;" placeholder="ইউটিউব এর ভিডিও লিংক এখানে দিন..." oninput="showPreview()" autocomplete="off">
                            <button class="btn btn-danger" type="submit" style="background: linear-gradient(45deg, #ff416c, #ff4b2b); border: none; color: white; font-weight: bold; padding: 0 25px;">Add Video</button>
                        </div>
                        <input type="hidden" name="EmbedType" id="embedType" value="YouTube">
                        <input type="hidden" name="Description" id="embedDescription" value="">
                    </form>
                    <div id="livePreview" style="display: none; margin-top: 20px; padding: 15px; background: #111; border: 1px solid #333; border-radius: 12px;">
                        <iframe id="previewFrame" width="100%" height="250" src="" frameborder="0" allowfullscreen style="border-radius: 10px; display: block;"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function showPreview() { /* ... */ }
        function extractVideoId(url) { /* ... */ }
    </script>
</body>
</html>