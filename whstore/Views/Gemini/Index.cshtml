@model List<whstore.Models.ProductModel>
@{
    ViewData["Title"] = "WH  STORE - Best Deals";
    var currentPage = Context.Request.Query.ContainsKey("page") ? int.Parse(Context.Request.Query["page"]) : 1;
}

<section style="background: linear-gradient(135deg, #0d1117 0%, #161b22 50%, #0dcaf0 150%); border: 1px solid rgba(13,202,240,0.15); border-radius: 20px; padding: 50px 30px; margin-bottom: 40px; text-align: center;">
    <h1 style="color: #0dcaf0; font-size: 2.5rem; font-weight: 800; margin-bottom: 10px;">🛍️ WH A STORE</h1>
    <p style="color: rgba(255,255,255,0.7); font-size: 1.1rem; margin-bottom: 25px;">Best Deals, Lowest Prices — সেরা প্রোডাক্ট সেরা দামে!</p>

    <form asp-action="Index" method="get" style="max-width: 500px; margin: 0 auto;">
        <div style="display: flex; gap: 10px;">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="🔍 Search products..."
                   style="flex: 1; padding: 12px 20px; border-radius: 50px; border: 1px solid rgba(13,202,240,0.3); font-size: 1rem; outline: none; background: #0d1117; color: white;" />
            <button type="submit" style="padding: 12px 25px; border-radius: 50px; border: none; background: #0dcaf0; color: #000; font-weight: 700; cursor: pointer;">Search</button>
        </div>
    </form>
</section>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <section id="upload-section" style="background: #0d1117; border: 1px solid #21262d; border-radius: 16px; padding: 30px; margin-bottom: 40px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="font-size: 1.4rem; color: #e6edf3;">📤 প্রোডাক্ট আপলোড করুন</h2>
            <button onclick="toggleUploadForm()" id="toggleBtn" style="padding: 8px 18px; background: #0dcaf0; border: none; border-radius: 25px; font-weight: 600; cursor: pointer;">➕ নতুন প্রোডাক্ট</button>
        </div>
        <div id="uploadForm" style="display: none; border-top: 1px solid #21262d; padding-top: 20px;">
            <form asp-action="SaveProduct" asp-controller="Home" method="post">
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px;">
                    <input type="text" name="Title" required placeholder="Product Title" style="padding: 10px; border-radius: 10px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <input type="text" name="Price" required placeholder="Price (৳)" style="padding: 10px; border-radius: 10px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <input type="url" name="ImageUrl" placeholder="Image URL" style="padding: 10px; border-radius: 10px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <input type="url" name="AffiliateLink" required placeholder="Affiliate Link" style="padding: 10px; border-radius: 10px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <div style="grid-column: 1 / -1;">
                        <textarea name="Description" placeholder="Description..." style="width: 100%; padding: 10px; border-radius: 10px; background: #161b22; border: 1px solid #21262d; color: white;"></textarea>
                    </div>
                </div>
                <button type="submit" style="margin-top: 20px; padding: 12px 40px; background: #0dcaf0; border: none; border-radius: 50px; font-weight: 700; cursor: pointer;">🚀 আপলোড করুন</button>
            </form>
        </div>
    </section>
}

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 25px;">
    @foreach (var product in Model)
    {
        <div style="background: #0d1117; border: 1px solid #21262d; border-radius: 16px; padding: 15px; transition: 0.3s;">
            <img src="@product.ImageUrl" loading="lazy" alt="@product.Title" style="width: 100%; height: 200px; object-fit: cover; border-radius: 10px;" />
            <h3 style="color: #e6edf3; font-size: 1rem; margin: 15px 0;">@product.Title</h3>
            <p style="color: #0dcaf0; font-size: 1.2rem; font-weight: 800;">৳@product.Price</p>
            <a href="@product.AffiliateLink" target="_blank" style="display: block; padding: 10px; background: #0dcaf0; color: #000; text-align: center; border-radius: 10px; text-decoration: none; font-weight: 700;">🛒 Buy Now</a>
        </div>
    }
</div>

<div style="text-align: center; margin-top: 40px;">
    @for (int i = 1; i <= 3; i++)
    {
        <a asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewData["CurrentFilter"]"
           style="padding: 10px 15px; margin: 0 5px; background: @(i == currentPage ? "#0dcaf0" : "#21262d"); color: @(i == currentPage ? "#000" : "#fff"); border-radius: 8px; text-decoration: none;">
            @i
        </a>
    }
</div>

<script>
    function toggleUploadForm() {
        var form = document.getElementById('uploadForm');
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }
</script>