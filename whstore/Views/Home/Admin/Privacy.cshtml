@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}
@model List<whstore.Models.Product>

<style>
    /* আপনার পূর্বের স্টাইলগুলো এখানে অপরিবর্তিত থাকবে */
    :root {
        --accent: #0dcaf0;
        --bg-dark: #0a0a0a;
        --card-bg: #111;
        --border: #222;
    }

    .control-center {
        max-width: 900px;
        margin: 30px auto;
        padding: 0 15px;
        color: #fff;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .stats {
        display: flex;
        gap: 15px;
    }

    .stat-box {
        background: var(--card-bg);
        padding: 15px 25px;
        border-radius: 12px;
        text-align: center;
        border: 1px solid var(--border);
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }

    .num {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--accent);
    }

    .label {
        font-size: 0.8rem;
        text-transform: uppercase;
        opacity: 0.7;
    }

    .search-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 25px;
    }

    #searchInput {
        flex-grow: 1;
        padding: 12px 20px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        color: #fff;
        border-radius: 50px;
        outline: none;
    }

    .btn-upload-toggle {
        background: var(--accent);
        color: #000;
        border: none;
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
    }

    .upload-form {
        display: none;
        background: #0d0d0d;
        padding: 25px;
        border-radius: 15px;
        border: 1px solid var(--border);
        margin-bottom: 25px;
    }

        .upload-form.show {
            display: block;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .full-width {
        grid-column: span 2;
    }

    input, textarea {
        width: 100%;
        padding: 12px;
        background: #1a1a1a;
        border: 1px solid var(--border);
        color: #fff;
        border-radius: 8px;
    }

    .inv-item {
        display: flex;
        align-items: center;
        background: var(--card-bg);
        padding: 15px;
        margin-bottom: 12px;
        border-radius: 12px;
        border: 1px solid var(--border);
    }

        .inv-item img {
            width: 60px;
            height: 60px;
            border-radius: 8px;
            object-fit: cover;
            margin-right: 15px;
            border: 1px solid var(--border);
        }

    .info {
        flex-grow: 1;
    }

    .title {
        font-weight: 600;
        font-size: 1.1rem;
    }

    .meta {
        font-size: 0.85rem;
        opacity: 0.6;
    }

    .price {
        font-weight: 700;
        color: var(--accent);
        margin-right: 20px;
    }

    .actions {
        display: flex;
        gap: 8px;
    }
</style>

<div class="control-center">
    <div class="top-bar">
        <h2>⚡ Admin Panel</h2>
        <div class="stats">
            <div class="stat-box"><div class="num">@(Model?.Count ?? 0)</div><div class="label">Total</div></div>
        </div>
    </div>

    <div class="search-bar">
        <input type="text" id="searchInput" placeholder="Search products..." oninput="filterProducts()" />
        <button class="btn-upload-toggle" onclick="toggleUploadForm()">+ Upload Product</button>
    </div>

    <div class="upload-form" id="uploadForm">
        <h4 class="mb-3">📦 Add New Product</h4>
        <form asp-action="SaveProduct" method="post">
            <div class="form-grid">
                <input type="text" name="Title" placeholder="Title *" required />
                <input type="text" name="Category" placeholder="Category" />
                <input type="text" name="Price" placeholder="Price *" required />
                <input type="text" name="OriginalPrice" placeholder="Original Price" />

                <div class="full-width" style="display: flex; gap: 10px;">
                    <input type="url" name="ImageUrl" id="imageUrlInput" placeholder="Image URL (Click 'Choose File' to upload)" />
                    <input type="file" id="filePicker" style="display:none" onchange="handleFile(this)" accept="image/*" />
                    <button type="button" class="btn btn-info" onclick="document.getElementById('filePicker').click()">Choose File</button>
                </div>
                <textarea name="Description" placeholder="Description..." class="full-width" rows="2"></textarea>
            </div>
            <button type="submit" style="padding: 12px; background:var(--accent); border:none; border-radius:8px; width:100%; font-weight:bold; margin-top:15px; cursor:pointer;">🚀 Save Product</button>
        </form>
    </div>

    <div id="inventoryList">
        @foreach (var product in Model ?? new List<whstore.Models.Product>())
        {
            <div class="inv-item">
                <img src="@product.ImageUrl" />
                <div class="info">
                    <div class="title">@product.Title</div>
                </div>
                <div class="price">৳@product.Price</div>
            </div>
        }
    </div>
</div>

<script>
    function toggleUploadForm() { document.getElementById('uploadForm').classList.toggle('show'); }

    // ফাইল সিলেক্ট করলে সেটি URL ফিল্ডে বসানোর ফাংশন
    function handleFile(input) {
        if (input.files && input.files[0]) {
            // বর্তমানে এটি লোকাল পাথ দেখাবে, সার্ভারে পাঠানোর জন্য আলাদা লজিক লাগবে
            document.getElementById('imageUrlInput').value = input.files[0].name;
            alert("File selected: " + input.files[0].name);
        }
    }

    function filterProducts() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('.inv-item').forEach(item => {
            item.style.display = item.innerText.toLowerCase().includes(query) ? 'flex' : 'none';
        });
    }
</script>