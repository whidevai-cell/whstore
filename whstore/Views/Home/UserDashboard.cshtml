@model List<whstore.Models.ProductModel>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="control-center">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <div class="top-bar">
        <h2>⚡ WH Admin Control Center</h2>
        <div class="stats">
            <div class="stat-box">
                <div class="num">@(Model?.Count ?? 0)</div>
                <div class="label">Total</div>
            </div>
            <div class="stat-box">
                <div class="num">@(Model?.Count(p => p.IsActive) ?? 0)</div>
                <div class="label">Active</div>
            </div>
            <div class="stat-box">
                <div class="num">@(Model?.Count(p => !p.IsActive) ?? 0)</div>
                <div class="label">Hidden</div>
            </div>
        </div>
    </div>

    <div class="search-bar">
        <input type="text" id="searchInput" placeholder="🔍 Search products..." oninput="filterProducts()" />
        <button class="btn-upload-toggle" onclick="toggleUploadForm()">➕ Upload Product</button>
    </div>

    <div class="upload-form" id="uploadForm">
        <h3>📦 Add New Product</h3>
        <form asp-action="SaveProduct" method="post">
            <div class="form-grid">
                <input type="text" name="Title" placeholder="Product Title *" required />
                <input type="text" name="Category" placeholder="Category" value="Gadget" />
                <input type="text" name="Price" placeholder="Price *" required />
                <input type="text" name="OriginalPrice" placeholder="Original Price" />
                <input type="url" name="ImageUrl" placeholder="Image URL" class="full-width" />
                <textarea name="Description" placeholder="Short description..." class="full-width" rows="2"></textarea>
            </div>
            <button type="submit" class="btn-submit">🚀 Save Product</button>
        </form>
    </div>

    <div class="inv-list" id="inventoryList">
        @if (Model != null && Model.Any())
        {
            @foreach (var product in Model)
            {
                <div class="inv-item @(!product.IsActive ? "inactive" : "")" data-title="@product.Title?.ToLower()">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://via.placeholder.com/50x50/111/0dcaf0?text=WH" : product.ImageUrl)" alt="@product.Title" />
                    <div class="info">
                        <div class="title">@product.Title</div>
                        <div class="meta">@product.Category • @(product.IsActive ? "🟢 Active" : "🔴 Hidden")</div>
                    </div>
                    <div class="price">৳@product.Price</div>
                    <div class="actions">
                        <button class="btn-edit" onclick="openEditModal(@product.Id, '@product.Title', '@product.Category', '@product.Price', '@product.ImageUrl')">✏️</button>

                        <form asp-action="ToggleProduct" asp-route-id="@product.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">@(product.IsActive ? "⏸️" : "▶️")</button>
                        </form>

                        <form asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" style="display:inline;" onsubmit="return confirm('⚠️ Delete this?');">
                            <button type="submit" class="btn-delete">🗑️</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-msg">📭 No products available.</div>
        }
    </div>
</div>

<div class="edit-overlay" id="editOverlay">
    <div class="edit-modal">
        <h3>✏️ Edit Product</h3>
        <form asp-action="UpdateProduct" method="post">
            <input type="hidden" name="Id" id="editId" />
            <input type="text" name="Title" id="editTitle" placeholder="Title" required />
            <input type="text" name="Price" id="editPrice" placeholder="Price" required />
            <div class="modal-actions">
                <button type="submit" class="btn-save">💾 Save Changes</button>
                <button type="button" class="btn-cancel" onclick="closeEditModal()">✖ Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleUploadForm() { document.getElementById('uploadForm').classList.toggle('show'); }
    function openEditModal(id, title, cat, price, img) {
        document.getElementById('editId').value = id;
        document.getElementById('editTitle').value = title;
        document.getElementById('editPrice').value = price;
        document.getElementById('editOverlay').classList.add('show');
    }
    function closeEditModal() { document.getElementById('editOverlay').classList.remove('show'); }

    function filterProducts() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('.inv-item').forEach(item => {
            item.style.display = item.getAttribute('data-title').includes(query) ? 'flex' : 'none';
        });
    }
</script>