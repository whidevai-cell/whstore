@model List<whstore.Models.ProductModel>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body { background: #050914; color: #e9f1ff; font-family: 'Segoe UI', sans-serif; }
    .control-center { max-width: 1180px; margin: 26px auto; padding: 18px; }
    .top-bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; align-items: center; padding: 18px 20px; border: 1px solid #16233c; background: rgba(4, 12, 28, 0.93); border-radius: 18px; }
    .top-bar h2 { margin: 0; font-size: 1.4rem; color: #6ee7b7; }
    .stats { display: flex; flex-wrap: wrap; gap: 12px; }
    .stat-box { background: #071323; border: 1px solid #17304f; border-radius: 14px; padding: 12px 16px; min-width: 105px; }
    .stat-box .num { font-size: 1.5rem; font-weight: 700; color: #38bdf8; }
    .stat-box .label { font-size: 0.78rem; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; }
    .search-bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 20px 0 16px; }
    .search-bar input { flex: 1 1 280px; min-width: 180px; padding: 12px 14px; border-radius: 14px; border: 1px solid #17304f; background: #081627; color: #f8fafc; }
    .btn-upload-toggle { border: none; border-radius: 14px; background: #22c55e; color: #071011; padding: 12px 18px; cursor: pointer; font-weight: 700; }
    .btn-upload-toggle:hover { background: #16a34a; }
    .upload-form { display: none; background: #081725; border: 1px solid #173750; border-radius: 18px; padding: 20px; margin-bottom: 18px; }
    .upload-form.show { display: block; }
    .upload-form h3 { margin-top: 0; margin-bottom: 16px; color: #7dd3fc; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-grid input, .form-grid textarea { width: 100%; padding: 12px 14px; border-radius: 14px; border: 1px solid #17304f; background: #07101f; color: #eef2ff; }
    .form-grid textarea { grid-column: 1 / -1; min-height: 118px; resize: vertical; }
    .form-grid .full-width { grid-column: 1 / -1; }
    .btn-submit { margin-top: 14px; border: none; border-radius: 14px; background: #2563eb; color: #fff; padding: 12px 20px; font-weight: 700; cursor: pointer; }
    .btn-submit:hover { background: #1d4ed8; }
    .inv-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .inv-item { background: #071526; border: 1px solid #15314f; border-radius: 18px; padding: 16px; gap: 14px; display: flex; align-items: center; min-height: 130px; }
    .inv-item img { width: 80px; height: 80px; border-radius: 18px; object-fit: cover; border: 1px solid #1e3a5d; }
    .info { flex: 1; min-width: 0; }
    .info .title { font-size: 1rem; font-weight: 700; margin-bottom: 8px; color: #e2e8f0; }
    .info .meta { color: #94a3b8; font-size: 0.9rem; line-height: 1.35; }
    .price { min-width: 70px; text-align: right; font-size: 1rem; font-weight: 700; color: #34d399; }
    .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .btn-edit, .btn-toggle, .btn-delete { border: none; border-radius: 12px; padding: 10px 14px; font-weight: 700; cursor: pointer; }
    .btn-edit { background: #fbbf24; color: #0f172a; }
    .btn-toggle { background: #64748b; color: #ffffff; }
    .btn-delete { background: #ef4444; color: #ffffff; }
    .alert-success, .alert-warning, .alert-error { border-radius: 16px; padding: 14px 18px; margin-bottom: 18px; }
    .alert-success { background: #0f2f16; border: 1px solid #166534; color: #bbf7d0; }
    .alert-warning { background: #1e293b; border: 1px solid #fbbf24; color: #fef3c7; }
    .alert-error { background: #2b1013; border: 1px solid #991b1b; color: #fecaca; }
    .empty-msg { padding: 40px 0; text-align: center; color: #94a3b8; }
    .edit-overlay { display: none; position: fixed; inset: 0; background: rgba(2, 10, 22, 0.88); align-items: center; justify-content: center; z-index: 50; }
    .edit-overlay.show { display: flex; }
    .edit-modal { width: min(540px, 95%); padding: 22px; border-radius: 18px; background: #081423; border: 1px solid #17334c; }
    .edit-modal h3 { margin-top: 0; color: #7dd3fc; }
    .edit-modal input { width: 100%; margin-bottom: 12px; padding: 12px 14px; border-radius: 14px; border: 1px solid #17304f; background: #07101f; color: #eef2ff; }
    .modal-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; margin-top: 12px; }
    .btn-save { background: #10b981; color: #fff; }
    .btn-cancel { background: #64748b; color: #fff; }
</style>

<div class="control-center">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert-warning">@TempData["Warning"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <div class="top-bar">
        <h2>⚡ WH Admin Control Center</h2>
        <div class="stats">
            <div class="stat-box">
                <div class="num">@(Model?.Count ?? 0)</div>
                <div class="label">Total</div>
            </div>
            <div class="stat-box">
                <div class="num">@(Model?.Count(p => p.IsActive) ?? 0)</div>
                <div class="label">Active</div>
            </div>
            <div class="stat-box">
                <div class="num">@(Model?.Count(p => !p.IsActive) ?? 0)</div>
                <div class="label">Hidden</div>
            </div>
        </div>
    </div>

    <div class="search-bar">
        <input type="text" id="searchInput" placeholder="🔍 Search products..." oninput="filterProducts()" />
        <button class="btn-upload-toggle" onclick="toggleUploadForm()">➕ Upload Product</button>
    </div>

    <div class="upload-form" id="uploadForm">
        <h3>📦 Add New Product</h3>
        <form asp-action="SaveProduct" method="post" enctype="multipart/form-data">
            <div class="form-grid">
                <input type="text" name="Title" placeholder="Product Title *" required />
                <input type="text" name="Category" placeholder="Category" value="Gadget" />
                <input type="text" name="Price" placeholder="Price *" required />
                <input type="text" name="OriginalPrice" placeholder="Original Price" />
                <input type="url" name="ImageUrl" placeholder="Image URL" class="full-width" />
                <input type="file" name="imageFile" accept="image/*" class="full-width" />
                <textarea name="Description" placeholder="Short description..." class="full-width" rows="2"></textarea>
            </div>
            <button type="submit" class="btn-submit">🚀 Save Product</button>
        </form>
    </div>

    <div class="inv-list" id="inventoryList">
        @if (Model != null && Model.Any())
        {
            @foreach (var product in Model)
            {
                <div class="inv-item @(!product.IsActive ? "inactive" : "")" data-title="@product.Title?.ToLower()">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://via.placeholder.com/50x50/111/0dcaf0?text=WH" : product.ImageUrl)" alt="@product.Title" />
                    <div class="info">
                        <div class="title">@product.Title</div>
                        <div class="meta">@product.Category • @(product.IsActive ? "🟢 Active" : "🔴 Hidden")</div>
                    </div>
                    <div class="price">৳@product.Price</div>
                    <div class="actions">
                        <button class="btn-edit" onclick="openEditModal(@product.Id, '@product.Title', '@product.Category', '@product.Price', '@product.ImageUrl')">✏️</button>

                        <form asp-action="ToggleVisibility" asp-route-id="@product.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">@(product.IsActive ? "⏸️" : "▶️")</button>
                        </form>

                        <form asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" style="display:inline;" onsubmit="return confirm('⚠️ Delete this?');">
                            <button type="submit" class="btn-delete">🗑️</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-msg">📭 No products available.</div>
        }
    </div>
</div>

<div class="edit-overlay" id="editOverlay">
    <div class="edit-modal">
        <h3>✏️ Edit Product</h3>
        <form asp-action="UpdateProduct" method="post">
            <input type="hidden" name="Id" id="editId" />
            <input type="text" name="Title" id="editTitle" placeholder="Title" required />
            <input type="text" name="Price" id="editPrice" placeholder="Price" required />
            <div class="modal-actions">
                <button type="submit" class="btn-save">💾 Save Changes</button>
                <button type="button" class="btn-cancel" onclick="closeEditModal()">✖ Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleUploadForm() { document.getElementById('uploadForm').classList.toggle('show'); }
    function openEditModal(id, title, cat, price, img) {
        document.getElementById('editId').value = id;
        document.getElementById('editTitle').value = title;
        document.getElementById('editPrice').value = price;
        document.getElementById('editOverlay').classList.add('show');
    }
    function closeEditModal() { document.getElementById('editOverlay').classList.remove('show'); }

    function filterProducts() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('.inv-item').forEach(item => {
            item.style.display = item.getAttribute('data-title').includes(query) ? 'flex' : 'none';
        });
    }
</script>