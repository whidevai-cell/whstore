@model IEnumerable<whstore.Models.Product>
@using System.Linq
@{
    ViewData["Title"] = "Admin Panel";
    var productList = Model?.ToList() ?? new List<whstore.Models.Product>();
}

<style>
    .control-center {
        max-width: 1180px;
        margin: 26px auto;
        padding: 18px;
    }

    .top-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
        padding: 18px 20px;
        border: 1px solid #16233c;
        background: rgba(4, 12, 28, 0.93);
        border-radius: 18px;
        margin-bottom: 24px;
    }

    .top-bar h2 {
        margin: 0;
        font-size: 1.4rem;
        color: #6ee7b7;
    }

    .stats {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .stat-box {
        background: #071323;
        border: 1px solid #17304f;
        border-radius: 14px;
        padding: 12px 16px;
        min-width: 105px;
    }

    .stat-box .num {
        font-size: 1.5rem;
        font-weight: 700;
        color: #38bdf8;
    }

    .stat-box .label {
        font-size: 0.78rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .inv-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .inv-item {
        background: #071526;
        border: 1px solid #15314f;
        border-radius: 14px;
        padding: 16px;
        transition: 0.3s;
    }

    .inv-item:hover {
        border-color: #38bdf8;
        background: #0b1e36;
    }

    .inv-item.inactive {
        opacity: 0.6;
        border-color: #1e293b;
    }

    .info .title {
        font-size: 1rem;
        font-weight: 700;
        color: #e2e8f0;
    }

    .info .meta {
        font-size: 0.8rem;
        color: #94a3b8;
    }

    .alert-success {
        background: #0f2f16;
        border: 1px solid #166534;
        color: #bbf7d0;
        padding: 14px;
        border-radius: 16px;
        margin-bottom: 18px;
    }

    .alert-error {
        background: #451a1a;
        border: 1px solid #991b1b;
        color: #fca5a5;
        padding: 14px;
        border-radius: 16px;
        margin-bottom: 18px;
    }
</style>

<div class="control-center">
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <div class="top-bar">
        <div>
            <h2>WH Secret Admin Panel</h2>
            <form asp-action="DeleteDetected" method="post" class="mt-2">
                <button type="submit" class="btn btn-danger btn-sm rounded-pill" onclick="return confirm('Are you sure you want to delete all detected products?')">
                    <i class="bi bi-trash3-fill"></i> Delete All Detected Products
                </button>
            </form>
        </div>
        <div class="stats">
            <div class="stat-box">
                <div class="num">@productList.Count</div> <div class="label">Total</div>
            </div>
            <div class="stat-box">
                <div class="num">@productList.Count(p => p.IsActive)</div> <div class="label">Active</div>
            </div>
            <div class="stat-box">
                <div class="num">@productList.Count(p => !p.IsActive)</div> <div class="label">Hidden</div>
            </div>
        </div>
    </div>

    <div class="inv-list" id="inventoryList">
        @if (productList.Any())
        {
            @foreach (var product in productList)
            {
                <div class="inv-item @(!product.IsActive ? "inactive" : "") d-flex justify-content-between align-items-center" data-title="@product.Title?.ToLower()" data-category="@product.Category?.ToLower()" data-price="@product.Price">
                    <div class="info">
                        <div class="title">@product.Title</div>
                        <div class="meta">@product.Category • @(product.IsActive ? "Active" : "Hidden")</div>
                    </div>
                    <div class="actions">
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Product" style="border-radius: 8px;">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-msg text-center text-muted py-5">No products found.</div>
        }
    </div>
</div>