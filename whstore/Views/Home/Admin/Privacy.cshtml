@model List<whstore.Models.ProductModel>
@{
    ViewData["Title"] = "Admin Panel";
}

<style>
    :root {
        --accent: #0dcaf0;
        --bg: #000;
        --border: #1a1a1a;
    }

    body {
        background: var(--bg);
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
    }

    .control-center {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
        padding: 15px;
        background: #0a0a0a;
        border: 1px solid var(--border);
        border-radius: 10px;
    }

        .top-bar h2 {
            margin: 0;
            color: var(--accent);
            font-size: 1.3rem;
        }

    .stats {
        display: flex;
        gap: 20px;
    }

    .stat-box {
        text-align: center;
        padding: 8px 15px;
        background: #111;
        border-radius: 8px;
        border: 1px solid var(--border);
    }

        .stat-box .num {
            font-size: 1.4rem;
            font-weight: bold;
            color: var(--accent);
        }

        .stat-box .label {
            font-size: 0.7rem;
            color: #888;
            text-transform: uppercase;
        }

    .search-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }

        .search-bar input {
            flex: 1;
            padding: 10px 15px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #111;
            color: #fff;
            font-size: 0.95rem;
            outline: none;
        }

            .search-bar input:focus {
                border-color: var(--accent);
            }

    .btn-upload-toggle {
        padding: 10px 20px;
        background: var(--accent);
        color: #000;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        font-size: 0.9rem;
    }

        .btn-upload-toggle:hover {
            background: #0bb5d4;
        }

    /* Upload Form */
    .upload-form {
        display: none;
        background: #0a0a0a;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

        .upload-form.show {
            display: block;
        }

        .upload-form h3 {
            color: var(--accent);
            margin-top: 0;
            margin-bottom: 15px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

        .form-grid input,
        .form-grid select,
        .form-grid textarea {
            padding: 10px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: #111;
            color: #fff;
            font-size: 0.9rem;
            outline: none;
        }

            .form-grid input:focus,
            .form-grid select:focus,
            .form-grid textarea:focus {
                border-color: var(--accent);
            }

        .form-grid .full-width {
            grid-column: 1 / -1;
        }

    .btn-submit {
        margin-top: 15px;
        padding: 12px 30px;
        background: #28a745;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        font-size: 0.95rem;
    }

        .btn-submit:hover {
            background: #218838;
        }

    /* Inventory List */
    .inv-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .inv-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px 15px;
        background: #0a0a0a;
        border: 1px solid var(--border);
        border-radius: 10px;
        transition: all 0.3s;
    }

        .inv-item:hover {
            border-color: var(--accent);
            box-shadow: 0 0 10px rgba(13, 202, 240, 0.1);
        }

        .inv-item.inactive {
            opacity: 0.4;
        }

        .inv-item img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid var(--border);
        }

        .inv-item .info {
            flex: 1;
        }

            .inv-item .info .title {
                font-weight: bold;
                font-size: 0.95rem;
                color: #fff;
            }

            .inv-item .info .meta {
                font-size: 0.75rem;
                color: #888;
                margin-top: 3px;
            }

        .inv-item .price {
            font-weight: bold;
            color: var(--accent);
            font-size: 1rem;
            min-width: 80px;
            text-align: right;
        }

        .inv-item .actions {
            display: flex;
            gap: 6px;
        }

            .inv-item .actions button {
                padding: 6px 10px;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                font-size: 0.75rem;
                font-weight: bold;
            }

    .btn-edit {
        background: #ffc107;
        color: #000;
    }

    .btn-toggle {
        background: #6c757d;
        color: #fff;
    }

    .btn-delete {
        background: #dc3545;
        color: #fff;
    }

    .btn-edit:hover {
        background: #e0a800;
    }

    .btn-toggle:hover {
        background: #5a6268;
    }

    .btn-delete:hover {
        background: #c82333;
    }

    /* Edit Modal */
    .edit-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }

        .edit-overlay.show {
            display: flex;
        }

    .edit-modal {
        background: #111;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 25px;
        width: 90%;
        max-width: 500px;
    }

        .edit-modal h3 {
            color: var(--accent);
            margin-top: 0;
            margin-bottom: 15px;
        }

        .edit-modal input,
        .edit-modal select {
            width: 100%;
            padding: 10px;
            margin-bottom: 12px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: #1a1a1a;
            color: #fff;
            font-size: 0.9rem;
            outline: none;
            box-sizing: border-box;
        }

            .edit-modal input:focus,
            .edit-modal select:focus {
                border-color: var(--accent);
            }

        .edit-modal .modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

    .btn-save {
        padding: 10px 25px;
        background: #28a745;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-cancel {
        padding: 10px 25px;
        background: #6c757d;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-save:hover {
        background: #218838;
    }

    .btn-cancel:hover {
        background: #5a6268;
    }

    .empty-msg {
        text-align: center;
        color: #555;
        padding: 40px;
        font-size: 1rem;
    }

    /* Notifications */
    .alert-success {
        background: #0f3d0f;
        border: 1px solid #28a745;
        color: #a8e6cf;
        padding: 12px 20px;
        border-radius: 8px;
        margin-bottom: 15px;
        font-weight: 600;
    }

    .alert-error {
        background: #3d0f0f;
        border: 1px solid #dc3545;
        color: #f8d7da;
        padding: 12px 20px;
        border-radius: 8px;
        margin-bottom: 15px;
        font-weight: 600;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .top-bar {
            flex-direction: column;
            text-align: center;
        }

        .stats {
            justify-content: center;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .inv-item {
            flex-wrap: wrap;
        }

            .inv-item .price {
                text-align: left;
                min-width: auto;
            }

            .inv-item .actions {
                width: 100%;
                justify-content: flex-end;
            }
    }
</style>

<div class="control-center">

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <!-- Top Bar -->
    <div class="top-bar">
        <h2>⚡ WH Admin Control Center</h2>
        <div class="stats">
            <div class="stat-box">
                <div class="num">@(Model?.Count ?? 0)</div>
                <div class="label">Total</div>
            </div>
            <div class="stat-box">
                <div class="num">@(Model?.Count(p => p.IsActive) ?? 0)</div>
                <div class="label">Active</div>
            </div>
            <div class="stat-box">
                <div class="num">@(Model?.Count(p => !p.IsActive) ?? 0)</div>
                <div class="label">Hidden</div>
            </div>
        </div>
    </div>

    <!-- Search + Upload Toggle -->
    <div class="search-bar">
        <input type="text" id="searchInput" placeholder="🔍 Search by title, category, or price..." oninput="filterProducts()" />
        <button class="btn-upload-toggle" onclick="toggleUploadForm()">➕ Upload</button>
    </div>

    <!-- Upload Form (Server-side) -->
    <div class="upload-form" id="uploadForm">
        <h3>📦 Upload New Product</h3>
        <form asp-action="SaveProduct" method="post">
            <div class="form-grid">
                <input type="text" name="Title" placeholder="Product Title *" required />
                <input type="text" name="Category" placeholder="Category" value="Gadget" />
                <input type="text" name="Price" placeholder="Price (e.g. 1299)" required />
                <input type="text" name="OriginalPrice" placeholder="Original Price (e.g. 1999)" />
                <input type="url" name="ImageUrl" placeholder="Image URL" class="full-width" />
                <input type="url" name="AffiliateLink" placeholder="Affiliate Link" class="full-width" />
                <textarea name="Description" placeholder="Short description..." class="full-width" rows="2" style="resize: vertical;"></textarea>
            </div>
            <button type="submit" class="btn-submit">🚀 Save Product</button>
        </form>
    </div>

    <!-- Inventory List -->
    <div class="inv-list" id="inventoryList">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var product in Model)
            {
                <div class="inv-item @(!product.IsActive ? "inactive" : "")" data-title="@product.Title?.ToLower()" data-category="@product.Category?.ToLower()" data-price="@product.Price">

                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" alt="@product.Title" onerror="this.src='https://via.placeholder.com/50x50/111/0dcaf0?text=WH'" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/50x50/111/0dcaf0?text=WH" alt="No Image" />
                    }

                    <div class="info">
                        <div class="title">@product.Title</div>
                        <div class="meta">
                            @product.Category • @(product.IsActive ? "🟢 Active" : "🔴 Hidden")
                            @if (product.IsHotProduct)
                            {
                                <span>• 🔥 Hot</span>
                            }
                        </div>
                    </div>

                    <div class="price">৳@product.Price</div>

                    <div class="actions">
                        <!-- Edit Button -->
                        <button class="btn-edit" onclick="openEditModal(@product.Id, '@product.Title?.Replace("'", "\\'")','@product.Category','@product.Price','@product.OriginalPrice','@product.ImageUrl','@product.AffiliateLink','@product.Description?.Replace("'", "\\'").Replace("\n", " ")')">✏️</button>

                        <!-- Toggle -->
                        <form asp-action="ToggleProduct" asp-route-id="@product.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle" title="Toggle Active/Hidden">
                                @(product.IsActive ? "⏸️" : "▶️")
                            </button>
                        </form>

                        <!-- Delete -->
                        <form asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" style="display:inline;" onsubmit="return confirm('⚠️ Delete this product?');">
                            <button type="submit" class="btn-delete">🗑️</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-msg">📭 No products found. Add your first product above! ☝️</div>
        }
    </div>
</div>

<!-- Edit Modal -->
<div class="edit-overlay" id="editOverlay">
    <div class="edit-modal">
        <h3>✏️ Edit Product</h3>
        <form asp-action="UpdateProduct" method="post">
            <input type="hidden" name="Id" id="editId" />
            <input type="text" name="Title" id="editTitle" placeholder="Title *" required />
            <input type="text" name="Category" id="editCategory" placeholder="Category" />
            <input type="text" name="Price" id="editPrice" placeholder="Price *" required />
            <input type="text" name="OriginalPrice" id="editOriginalPrice" placeholder="Original Price" />
            <input type="url" name="ImageUrl" id="editImage" placeholder="Image URL" />
            <input type="url" name="AffiliateLink" id="editLink" placeholder="Affiliate Link" />
            <input type="text" name="Description" id="editDesc" placeholder="Description" />
            <div class="modal-actions">
                <button type="submit" class="btn-save">💾 Save</button>
                <button type="button" class="btn-cancel" onclick="closeEditModal()">✖ Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    // ========== TOGGLE UPLOAD FORM ==========
    function toggleUploadForm() {
        document.getElementById('uploadForm').classList.toggle('show');
    }

    // ========== CLIENT-SIDE SEARCH ==========
    function filterProducts() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        const items = document.querySelectorAll('.inv-item');

        items.forEach(item => {
            const title = item.getAttribute('data-title') || '';
            const category = item.getAttribute('data-category') || '';
            const price = item.getAttribute('data-price') || '';

            if (title.includes(query) || category.includes(query) || price.includes(query)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    // ========== OPEN EDIT MODAL ==========
    function openEditModal(id, title, category, price, originalPrice, imageUrl, affiliateLink, description) {
        document.getElementById('editId').value = id;
        document.getElementById('editTitle').value = title || '';
        document.getElementById('editCategory').value = category || '';
        document.getElementById('editPrice').value = price || '';
        document.getElementById('editOriginalPrice').value = originalPrice || '';
        document.getElementById('editImage').value = imageUrl || '';
        document.getElementById('editLink').value = affiliateLink || '';
        document.getElementById('editDesc').value = description || '';
        document.getElementById('editOverlay').classList.add('show');
    }

    // ========== CLOSE EDIT MODAL ==========
    function closeEditModal() {
        document.getElementById('editOverlay').classList.remove('show');
    }

    // ESC key to close modal
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeEditModal();
    });

    // Auto-hide notifications after 4 seconds
    setTimeout(() => {
        document.querySelectorAll('.alert-success, .alert-error').forEach(el => {
            el.style.transition = 'opacity 0.5s';
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 500);
        });
    }, 4000);
</script>
