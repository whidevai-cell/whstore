@model List<whstore.Models.ProductModel>
@{
    ViewData["Title"] = "Admin Panel";
}

<style>
    :root {
        --accent: #0dcaf0;
        --bg: #050505;
        --panel: #0b0b0b;
        --border: #1e1e1e;
        --text: #f3f6fb;
        --muted: #8a92a4;
    }

    .control-center {
        max-width: 1180px;
        margin: 1.8rem auto 3rem;
        padding: 0 18px;
    }

    .page-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

    .page-title h1 {
        margin: 0;
        font-size: 2rem;
        color: #fff;
        letter-spacing: 0.02em;
    }

    .page-title .subtitle {
        color: var(--muted);
        margin: 0;
        font-size: 0.95rem;
    }

    .top-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .stat-box {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 18px 16px;
        min-height: 104px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .stat-box .num {
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 6px;
    }

    .stat-box .label {
        font-size: 0.8rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.07em;
    }

    .card-panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 22px;
        margin-bottom: 22px;
    }

    .search-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .search-bar input {
        flex: 1;
        min-width: 220px;
        max-width: 640px;
        padding: 12px 16px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: #111;
        color: #fff;
        font-size: 0.95rem;
        outline: none;
    }

    .search-bar input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(13, 202, 240, 0.08);
    }

    .btn-upload-toggle {
        padding: 12px 22px;
        background: var(--accent);
        color: #050505;
        border: none;
        border-radius: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.25s;
        white-space: nowrap;
    }

    .btn-upload-toggle:hover {
        background: #0ab8d8;
    }

    .upload-form {
        display: none;
        background: #090909;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .upload-form.show {
        display: block;
    }

    .upload-form h3 {
        color: var(--accent);
        margin-top: 0;
        margin-bottom: 16px;
        font-size: 1.15rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
    }

    .form-grid input,
    .form-grid select,
    .form-grid textarea {
        width: 100%;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: #111;
        color: #fff;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-grid input:focus,
    .form-grid select:focus,
    .form-grid textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(13, 202, 240, 0.08);
    }

    .form-grid .full-width {
        grid-column: 1 / -1;
    }

    .btn-submit {
        margin-top: 18px;
        padding: 13px 28px;
        background: linear-gradient(135deg, #08c18f, #209644);
        color: #fff;
        border: none;
        border-radius: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s, opacity 0.2s;
    }

    .btn-submit:hover {
        transform: translateY(-1px);
        opacity: 0.95;
    }

    .inv-list {
        display: grid;
        gap: 14px;
    }

    .inv-item {
        display: grid;
        grid-template-columns: 70px minmax(0, 1fr) auto auto;
        gap: 14px;
        align-items: center;
        padding: 16px 18px;
        background: #0b0b0b;
        border: 1px solid var(--border);
        border-radius: 18px;
        transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }

    .inv-item:hover {
        border-color: var(--accent);
        transform: translateY(-1px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.24);
    }

    .inv-item.inactive {
        opacity: 0.55;
    }

    .inv-item img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 16px;
        border: 1px solid var(--border);
    }

    .inv-item .info {
        min-width: 0;
    }

    .inv-item .info .title {
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        margin-bottom: 0.2rem;
    }

    .inv-item .info .meta {
        font-size: 0.82rem;
        color: var(--muted);
        line-height: 1.4;
    }

    .inv-item .price {
        font-weight: 700;
        color: var(--accent);
        font-size: 1rem;
        text-align: right;
        min-width: 90px;
    }

    .inv-item .actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .inv-item .actions button {
        padding: 8px 12px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 700;
        transition: transform 0.2s;
    }

    .inv-item .actions button:hover {
        transform: translateY(-1px);
    }

    .btn-edit {
        background: #ffc107;
        color: #050505;
    }

    .btn-toggle {
        background: #6c757d;
        color: #fff;
    }

    .btn-delete {
        background: #dc3545;
        color: #fff;
    }

    .btn-edit:hover {
        background: #e0a800;
    }

    .btn-toggle:hover {
        background: #5a6268;
    }

    .btn-delete:hover {
        background: #c82333;
    }

    .edit-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.88);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 18px;
    }

    .edit-overlay.show {
        display: flex;
    }

    .edit-modal {
        background: #111;
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 26px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
    }

    .edit-modal h3 {
        color: var(--accent);
        margin-top: 0;
        margin-bottom: 18px;
    }

    .edit-modal input,
    .edit-modal select {
        width: 100%;
        padding: 12px 14px;
        margin-bottom: 14px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: #141414;
        color: #fff;
        font-size: 0.95rem;
        outline: none;
        box-sizing: border-box;
    }

    .edit-modal input:focus,
    .edit-modal select:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(13, 202, 240, 0.08);
    }

    .edit-modal .modal-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-save,
    .btn-cancel {
        flex: 1;
        min-width: 120px;
    }

    .btn-save {
        background: #28a745;
        color: #fff;
    }

    .btn-cancel {
        background: #6c757d;
        color: #fff;
    }

    .empty-msg {
        text-align: center;
        color: #7d8592;
        padding: 50px 20px;
        font-size: 1rem;
        background: #0a0a0a;
        border: 1px dashed rgba(255, 255, 255, 0.08);
        border-radius: 18px;
    }

    .alert-success,
    .alert-error {
        border-radius: 18px;
        padding: 14px 18px;
        margin-bottom: 18px;
        font-weight: 600;
        letter-spacing: 0.01em;
    }

    .alert-success {
        background: rgba(40, 167, 69, 0.12);
        border: 1px solid #28a745;
        color: #b9f5d1;
    }

    .alert-error {
        background: rgba(220, 53, 69, 0.12);
        border: 1px solid #dc3545;
        color: #f5c6cb;
    }

    .image-paste-area {
        border: 2px dashed #333;
        border-radius: 16px;
        padding: 18px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
        background: #090909;
        margin-bottom: 14px;
        min-height: 100px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .image-paste-area:hover {
        border-color: var(--accent);
        box-shadow: 0 8px 30px rgba(13, 202, 240, 0.08);
    }

    .image-paste-area.has-image {
        border-color: #28a745;
    }

    .image-paste-area .paste-text {
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 8px;
    }

    #pastedPreview {
        max-width: 100%;
        max-height: 140px;
        border-radius: 14px;
        display: none;
        margin-top: 14px;
    }

    .mini-gallery {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .mini-gallery img {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: 14px;
        border: 2px solid var(--border);
        cursor: pointer;
        transition: all 0.25s;
    }

    .mini-gallery img:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    .mini-gallery img.active {
        border-color: var(--accent);
        box-shadow: 0 0 10px rgba(13, 202, 240, 0.35);
    }

@@media (max-width: 860px) {
        .inv-item {
            grid-template-columns: 70px 1fr;
        }

        .price,
        .actions {
            justify-self: start;
            text-align: left;
        }

        .actions {
            width: 100%;
        }
    }

@@media (max-width: 600px) {
        .search-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-upload-toggle {
            width: 100%;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .inv-item {
            grid-template-columns: 70px 1fr;
        }
    }
</style>

<div class="control-center">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <div class="page-title">
        <div>
            <h1>WH Admin Control Center</h1>
            <p class="subtitle">Manage products, view inventory status, and publish updates quickly.</p>
        </div>
        <button class="btn-upload-toggle" onclick="toggleUploadForm()">? Add Product</button>
    </div>
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <div class="top-bar">
        <h2>? WH Secret Admin Panel</h2>
        <div class="stats">
            <div class="stat-box">
                <div class="num">@(Model?.Count ?? 0)</div>
                <div class="label">Total</div>
            </div>
            <div class="stat-box">
                <div class="num">@(Model?.Count(p => p.IsActive) ?? 0)</div>
                <div class="label">Active</div>
            </div>
            <div class="stat-box">
                <div class="num">@(Model?.Count(p => !p.IsActive) ?? 0)</div>
                <div class="label">Hidden</div>
            </div>
        </div>
    </div>

    <div class="search-bar">
        <input type="text" id="searchInput" placeholder="?? Search by title, category, or price..." oninput="filterProducts()" />
        <button class="btn-upload-toggle" onclick="toggleUploadForm()">? Upload</button>
    </div>

    <div class="upload-form" id="uploadForm">
        <h3>?? Upload New Product</h3>
        <form asp-action="SaveProduct" method="post">

            <div class="image-paste-area" id="imagePasteArea" onclick="document.getElementById('hiddenPasteInput').focus()">
                <div id="pastePlaceholder">
                    <div style="font-size:1.5rem;">??</div>
                    <div class="paste-text">Click here & Paste image (Ctrl+V)</div>
                </div>
                <img id="pastedPreview" src="" alt="Preview" />
                <input type="text" id="hiddenPasteInput" style="position:absolute; opacity:0; pointer-events:none;" />
            </div>

            <div class="mini-gallery" id="adminMiniGallery"></div>

            <div class="form-grid">
                <input type="text" name="Title" placeholder="Product Title *" required />
                <select name="Category">
                    <option value="Gadget">?? Gadget</option>
                    <option value="Fashion">?? Fashion</option>
                    <option value="Electronics">?? Electronics</option>
                    <option value="Home">?? Home & Living</option>
                    <option value="Beauty">?? Beauty</option>
                    <option value="Sports">? Sports</option>
                    <option value="Books">?? Books</option>
                    <option value="General">?? General</option>
                </select>
                <input type="text" name="Price" placeholder="Price (e.g. 1299)" required />
                <input type="text" name="OriginalPrice" placeholder="Original Price (e.g. 1999)" />
                <input type="url" name="ImageUrl" id="uploadImageUrl" placeholder="Image URL (or paste above)" class="full-width" />
                <input type="url" name="AffiliateLink" placeholder="Affiliate Link" class="full-width" />
                <input type="text" name="StoreName" placeholder="Store Name (Daraz / AliExpress)" />
                <input type="text" name="ShippingCost" placeholder="Shipping Cost (Free / ?60)" />
                <textarea name="Description" placeholder="Short description..." class="full-width" rows="2" style="resize: vertical;"></textarea>
            </div>
            <button type="submit" class="btn-submit">?? Save Product</button>
        </form>
    </div>

    <div class="inv-list" id="inventoryList">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var product in Model)
            {
                <div class="inv-item @(!product.IsActive ? "inactive" : "")" data-title="@product.Title?.ToLower()" data-category="@product.Category?.ToLower()" data-price="@product.Price">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" alt="@product.Title" onerror="this.src='https://via.placeholder.com/50x50/111/0dcaf0?text=WH'" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/50x50/111/0dcaf0?text=WH" alt="No Image" />
                    }
                    <div class="info">
                        <div class="title">@product.Title</div>
                        <div class="meta">
                            @product.Category • @(product.IsActive ? "?? Active" : "?? Hidden")
                            @if (product.IsHotProduct)
                            {
                                <span>• ?? Hot</span>
                            }
                        </div>
                    </div>
                    <div class="price">?@product.Price</div>
                    <div class="actions">
                        <button class="btn-edit" onclick="openEditModal(@product.Id, '@Html.Raw(product.Title?.Replace("'", "\\'") ?? "")', '@(product.Category ?? "")', '@(product.Price ?? "")', '@(product.OriginalPrice ?? "")', '@Html.Raw(product.ImageUrl?.Replace("'", "\\'") ?? "")', '@Html.Raw(product.AffiliateLink?.Replace("'", "\\'") ?? "")', '@Html.Raw(product.Description?.Replace("'", "\\'").Replace("\n", " ").Replace("\r", "") ?? "")')">??</button>

                        <form asp-action="ToggleProduct" asp-route-id="@product.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle" title="Toggle Active/Hidden">
                                @(product.IsActive ? "??" : "??")
                            </button>
                        </form>

                        <form asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" style="display:inline;" onsubmit="return confirm('?? Delete this product?');">
                            <button type="submit" class="btn-delete">???</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-msg">?? No products found. Add your first product above! ??</div>
        }
    </div>
</div>

<div class="edit-overlay" id="editOverlay">
    <div class="edit-modal">
        <h3>?? Edit Product</h3>
        <form asp-action="UpdateProduct" method="post">
            <input type="hidden" name="Id" id="editId" />
            <input type="text" name="Title" id="editTitle" placeholder="Title *" required />
            <input type="text" name="Category" id="editCategory" placeholder="Category" />
            <input type="text" name="Price" id="editPrice" placeholder="Price *" required />
            <input type="text" name="OriginalPrice" id="editOriginalPrice" placeholder="Original Price" />
            <input type="url" name="ImageUrl" id="editImage" placeholder="Image URL" />
            <input type="url" name="AffiliateLink" id="editLink" placeholder="Affiliate Link" />
            <input type="text" name="Description" id="editDesc" placeholder="Description" />
            <div class="modal-actions">
                <button type="submit" class="btn-save">?? Save</button>
                <button type="button" class="btn-cancel" onclick="closeEditModal()">? Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleUploadForm() {
        document.getElementById('uploadForm').classList.toggle('show');
    }

    function filterProducts() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        const items = document.querySelectorAll('.inv-item');
        items.forEach(item => {
            const title = item.getAttribute('data-title') || '';
            const category = item.getAttribute('data-category') || '';
            const price = item.getAttribute('data-price') || '';
            if (title.includes(query) || category.includes(query) || price.includes(query)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    let adminImageList = [];

    document.addEventListener('paste', function (e) {
        const items = (e.clipboardData || e.originalEvent.clipboardData).items;
        for (const item of items) {
            if (item.kind === 'file' && item.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    setPastedImage(event.target.result);
                    addToAdminGallery(event.target.result);
                };
                reader.readAsDataURL(item.getAsFile());
            }
        }
    });

    function setPastedImage(src) {
        const preview = document.getElementById('pastedPreview');
        const placeholder = document.getElementById('pastePlaceholder');
        const area = document.getElementById('imagePasteArea');

        preview.src = src;
        preview.style.display = 'block';
        placeholder.style.display = 'none';
        area.classList.add('has-image');
        document.getElementById('uploadImageUrl').value = src;
    }

    function addToAdminGallery(src) {
        if (adminImageList.includes(src)) return;
        adminImageList.push(src);

        const gallery = document.getElementById('adminMiniGallery');
        const img = document.createElement('img');
        img.src = src;
        img.className = 'active';
        img.onclick = function () {
            setPastedImage(src);
            gallery.querySelectorAll('img').forEach(i => i.classList.remove('active'));
            img.classList.add('active');
        };
        img.onerror = function () {
            img.remove();
            adminImageList = adminImageList.filter(i => i !== src);
        };

        gallery.appendChild(img);
        gallery.querySelectorAll('img').forEach(i => i.classList.remove('active'));
        img.classList.add('active');
    }

    var uploadImageUrlEl = document.getElementById('uploadImageUrl');
    if (uploadImageUrlEl) {
        uploadImageUrlEl.addEventListener('input', function () {
            const url = this.value;
            if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
                setPastedImage(url);
                addToAdminGallery(url);
            }
        });
    }

    function openEditModal(id, title, category, price, originalPrice, imageUrl, affiliateLink, description) {
        document.getElementById('editId').value = id;
        document.getElementById('editTitle').value = title || '';
        document.getElementById('editCategory').value = category || '';
        document.getElementById('editPrice').value = price || '';
        document.getElementById('editOriginalPrice').value = originalPrice || '';
        document.getElementById('editImage').value = imageUrl || '';
        document.getElementById('editLink').value = affiliateLink || '';
        document.getElementById('editDesc').value = description || '';
        document.getElementById('editOverlay').classList.add('show');
    }

    function closeEditModal() {
        document.getElementById('editOverlay').classList.remove('show');
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeEditModal();
    });

    setTimeout(() => {
        document.querySelectorAll('.alert-success, .alert-error').forEach(el => {
            el.style.transition = 'opacity 0.5s';
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 500);
        });
    }, 4000);
</script>
