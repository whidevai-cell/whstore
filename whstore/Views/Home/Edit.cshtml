@model whstore.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<style>
    .edit-container {
        max-width: 800px;
        margin: 30px auto;
        padding: 25px;
        background: rgba(4, 12, 28, 0.93);
        border: 1px solid #16233c;
        border-radius: 18px;
    }

    .edit-container h2 {
        color: #6ee7b7;
        margin-bottom: 20px;
    }

    .form-control {
        background: #071526;
        border: 1px solid #15314f;
        color: #e2e8f0;
    }

    .form-control:focus {
        background: #0b1e36;
        border-color: #38bdf8;
        color: #e2e8f0;
    }
    
    .btn-primary {
        background: #38bdf8;
        color: #000;
        font-weight: 600;
        border: none;
    }
</style>

<div class="edit-container">
    <h2>Edit Product</h2>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <div class="row">
            <div class="col-md-4">
                <img src="@(!string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content(Model.ImageUrl) : "https://via.placeholder.com/150?text=No+Image")" 
                     alt="Product Image" 
                     class="img-fluid rounded" 
                     style="aspect-ratio: 1; object-fit: cover; border: 1px solid #15314f;"/>
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title</label>
                    <input asp-for="Title" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price</label>
                    <input asp-for="Price" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Category</label>
                    <input asp-for="Category" class="form-control" />
                </div>
            </div>
        </div>

        <div class="mb-3 mt-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label">Image URL</label>
            <input asp-for="ImageUrl" class="form-control" />
        </div>
        
        <div class="mb-3">
            <label asp-for="AffiliateLink" class="form-label">Affiliate Link</label>
            <input asp-for="AffiliateLink" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>

        <div class="d-flex justify-content-end">
            <a asp-action="Privacy" class="btn btn-secondary me-2">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>
