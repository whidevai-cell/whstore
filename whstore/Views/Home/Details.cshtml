@model whstore.Models.ProductModel

@{
    if (Model == null)
    {
        <div class="container py-5 text-center">
            <h3 class="text-muted">Product not found</h3>
            <a href="/" class="btn btn-outline-info mt-3">Back to Home</a>
        </div>
        return;
    }

    ViewData["Title"] = "Product Details - " + (Model.Title ?? "Item");
    var imageSrc = !string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "https://via.placeholder.com/600x400?text=No+Image";
    var buyLink = !string.IsNullOrEmpty(Model.AffiliateLink) ? Model.AffiliateLink : "#";
}

<style>
    body {
        background-color: #000;
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
    }

    .details-container {
        background: #0a0a0a;
        border: 1px solid #222;
        border-radius: 15px;
        padding: 30px;
        margin-top: 50px;
        margin-bottom: 50px;
    }

    .product-img {
        max-width: 100%;
        border-radius: 10px;
        border: 1px solid #333;
        background: #fff;
        padding: 10px;
        display: block;
        margin: 0 auto;
    }

    .price-text {
        color: #0dcaf0;
        font-size: 2.2rem;
        font-weight: bold;
    }

    .old-price {
        text-decoration: line-through;
        color: #666;
        margin-left: 10px;
        font-size: 1.2rem;
    }

    .btn-buy {
        background: linear-gradient(45deg, #0dcaf0, #007bff);
        color: #fff;
        font-weight: bold;
        padding: 15px 35px;
        border-radius: 50px;
        text-decoration: none;
        display: inline-block;
        transition: 0.3s;
        width: 100%;
        text-align: center;
    }

        .btn-buy:hover {
            transform: translateY(-3px);
            color: #fff;
            box-shadow: 0 5px 15px rgba(13, 202, 240, 0.4);
        }

    .desc-box {
        background: #111;
        border-left: 4px solid #0dcaf0;
        padding: 20px;
        border-radius: 5px;
        margin-top: 25px;
        color: #ddd;
        line-height: 1.6;
    }

    .meta-item {
        background: #161616;
        padding: 10px 15px;
        border-radius: 8px;
        margin-right: 10px;
        display: inline-block;
        border: 1px solid #222;
    }
</style>

<div class="container">
    <div class="details-container">
        <div class="row">
            <div class="col-md-5 mb-4">
                <img src="@imageSrc" class="product-img shadow-lg" alt="@Model.Title">
            </div>
            <div class="col-md-7">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2" style="background:transparent;">
                        <li class="breadcrumb-item"><a href="/" class="text-info text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item active text-muted">Details</li>
                    </ol>
                </nav>

                <h1 class="fw-bold mb-3">@Model.Title</h1>

                <div class="mb-4">
                    <span class="price-text">৳ @Model.Price</span>
                    @if (!string.IsNullOrEmpty(Model.OriginalPrice))
                    {
                        <span class="old-price">৳ @Model.OriginalPrice</span>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <div class="meta-item">
                        <small class="text-muted d-block">Store</small>
                        <span class="text-info fw-bold">@(Model.StoreName ?? "Global")</span>
                    </div>
                    <div class="meta-item">
                        <small class="text-muted d-block">Category</small>
                        <span class="text-white">@(Model.Category ?? "General")</span>
                    </div>
                </div>

                <div class="desc-box">
                    <h5 class="text-info fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Product Description</h5>
                    <p>@(string.IsNullOrEmpty(Model.Description) ? "No detailed description available for this item." : Model.Description)</p>
                </div>

                <div class="mt-5">
                    @if (buyLink != "#")
                    {
                        <a href="@buyLink" target="_blank" class="btn-buy shadow">
                            <i class="bi bi-bag-check-fill me-2"></i> GET THIS PRODUCT NOW
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100" disabled>LINK UNAVAILABLE</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>