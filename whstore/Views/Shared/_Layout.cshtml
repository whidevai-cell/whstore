<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WH-STORE</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/whstore.styles.css" asp-append-version="true" />
    <link rel="icon" href="~/images/logo.jpeg" type="image/jpeg" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-dark navbar-expand-lg">
            <div class="container-fluid px-0">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.jpeg" alt="WH-STORE Logo" style="height: 30px; margin-right: 10px; border-radius: 4px;" />
                    WH-STORE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @{
                            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        }
                        <li class="nav-item">
                            <a class="nav-link games-link" asp-controller="Game" asp-action="Index">GAMES</a>
                        </li>
                    </ul>
                    <form class="d-flex me-2" asp-controller="Home" asp-action="Index" method="get">
                        <div class="custom-search-group">
                            <input class="form-control search-input" type="search" name="searchString" placeholder="Search..." value="@ViewData["CurrentFilter"]" autocomplete="off">
                            <button class="search-btn" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <div class="nav-item dropdown">
                        <a class="nav-link" href="#" id="settingsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-gear fs-5 text-info"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end glass-dropdown" aria-labelledby="settingsDropdown">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Privacy">Admin</a></li>
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#embedModal">Embed</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid py-4 my-4 glassmorphism-panel rounded-3">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Embed Modal -->
    <div class="modal fade" id="embedModal" tabindex="-1" role="dialog" aria-labelledby="embedModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" style="background: #1a1a1a; border-radius: 20px; border: 1px solid #333; color:white;">
                <div class="modal-header" style="border-bottom: 1px solid #333;">
                    <h5 class="modal-title" id="embedModalLabel" style="color: #ff4d4d;">🎬 Add New Video</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row justify-content-center">
                        <div class="col-md-12">
                            <form asp-action="Create" asp-controller="Home" method="post" id="embedForm">

                                <!-- Title Input -->
                                <div class="mb-3">
                                    <input type="text" name="Title" id="videoTitle" class="form-control"
                                           style="background: #222; border: 1px solid #444; color: #fff; padding: 12px; border-radius: 10px;"
                                           placeholder="🎬 Video Title দিন (optional - auto generate হবে)"
                                           autocomplete="off">
                                </div>

                                <!-- URL Input + Button -->
                                <div class="input-group">
                                    <span class="input-group-text" style="background: #222; border: 1px solid #444; color: #ff4d4d;">
                                        <i class="bi bi-link-45deg"></i>
                                    </span>
                                    <input type="url" name="EmbedUrl" id="videoUrl" class="form-control" required
                                           style="background: #222; border: 1px solid #444; color: #fff; padding: 12px;"
                                           placeholder="ইউটিউব এর ভিডিও লিংক এখানে দিন..."
                                           oninput="showPreview()" autocomplete="off">
                                    <button class="btn btn-danger" type="submit"
                                            style="background: linear-gradient(45deg, #ff416c, #ff4b2b); border: none; color: white; font-weight: bold; padding: 0 25px;">
                                        Add Video
                                    </button>
                                </div>

                                <!-- Hidden Fields -->
                                <input type="hidden" name="EmbedType" id="embedType" value="YouTube">
                                <input type="hidden" name="Description" id="embedDescription" value="">

                                <div class="mt-2 text-center">
                                    <small style="color: #555;">Supported: YouTube Videos, Shorts, and Mobile Links</small>
                                </div>
                            </form>

                            <!-- ===== LIVE PREVIEW ===== -->
                            <div id="livePreview" style="display: none; margin-top: 20px; padding: 15px; background: #111; border: 1px solid #333; border-radius: 12px;">
                                <h6 style="color: #ff4d4d; font-size: 0.85rem; margin-bottom: 10px;">👁️ Live Preview:</h6>
                                <iframe id="previewFrame" width="100%" height="250" src="" frameborder="0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen style="border-radius: 10px; display: block;"></iframe>
                                <p style="text-align: center; color: #6e7681; font-size: 0.75rem; margin-top: 8px;">
                                    ✅ "Add Video" click করলে Auto Save হবে
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function showPreview() {
            var url = document.getElementById('videoUrl').value.trim();
            var preview = document.getElementById('livePreview');
            var frame = document.getElementById('previewFrame');
            var typeField = document.getElementById('embedType');
            var titleField = document.getElementById('videoTitle');

            if (url) {
                var videoId = extractVideoId(url);
                if (videoId) {
                    frame.src = 'https://www.youtube.com/embed/' + videoId;
                    preview.style.display = 'block';
                    typeField.value = url.includes('shorts/') ? 'YouTube Shorts' : 'YouTube';

                    if (!titleField.value) {
                        titleField.value = (url.includes('shorts/') ? 'YouTube Shorts' : 'YouTube Video') + ' - ' + videoId;
                    }
                } else {
                    preview.style.display = 'none';
                    frame.src = '';
                }
            } else {
                preview.style.display = 'none';
                frame.src = '';
            }
        }

        function extractVideoId(url) {
            if (!url) return null;
            if (url.includes("shorts/")) {
                return url.split("shorts/")[1].split("?")[0].substring(0, 11);
            } else if (url.includes("v=")) {
                return url.split("v=")[1].split("&")[0].substring(0, 11);
            } else if (url.includes("youtu.be/")) {
                return url.split("youtu.be/")[1].split("?")[0].substring(0, 11);
            } else if (url.includes("embed/")) {
                return url.split("embed/")[1].split("?")[0].substring(0, 11);
            }
            return null;
        }

        // Use event delegation for the form submission
        document.addEventListener('submit', function(e) {
            if (e.target && e.target.id === 'embedForm') {
                var titleField = document.getElementById('videoTitle');
                var urlField = document.getElementById('videoUrl');

                if (!titleField.value.trim()) {
                    var videoId = extractVideoId(urlField.value);
                    if (videoId) {
                        var isShorts = urlField.value.includes('shorts/');
                        titleField.value = (isShorts ? 'YouTube Shorts' : 'YouTube Video') + ' - ' + videoId;
                    } else {
                        titleField.value = 'Video - ' + new Date().toLocaleString();
                    }
                }
            }
        });
        
        // Clear modal on hide
        var embedModal = document.getElementById('embedModal');
        embedModal.addEventListener('hidden.bs.modal', function () {
            document.getElementById('embedForm').reset();
            document.getElementById('livePreview').style.display = 'none';
            document.getElementById('previewFrame').src = '';
        });
    </script>
</body>
</html>