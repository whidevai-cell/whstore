@model IEnumerable<whstore.Models.DailyPost>

@{
    ViewData["Title"] = "Income Dashboard";
}

<div class="container mt-5" style="max-width: 700px;">
    <div class="text-center mb-4">
        <h2 style="color: white;">Income Dashboard</h2>
        <p style="color: #666;">আপনার আয়-ব্যয়ের হিসাব ও ডেইলি আপডেট এখানে ম্যানেজ করুন</p>
    </div>

    <div class="card p-4 mb-4" style="background: #1a1a1a; border-radius: 15px; border: 1px solid #333;">
        <div class="card-body p-0">
            <h5 class="mb-3" style="color: #4da6ff;">আজকের আপডেট শেয়ার করুন</h5>
            
            <form asp-action="CreatePost" method="post">
                <div class="mb-3">
                    <textarea name="content" class="form-control text-white" rows="3" 
                              style="background: #252525; border: 1px solid #444; border-radius: 10px; resize: none;" 
                              placeholder="ফেসবুকের মতো কিছু লিখুন..."></textarea>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-4" style="border-radius: 8px;">পোস্ট করুন</button>
                </div>
            </form>
        </div>
    </div>

    <div class="post-list">
        <h4 class="text-white mb-3" style="border-left: 4px solid #4da6ff; padding-left: 10px;">ডেইলি টাইমলাইন</h4>
        
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="card mb-3" style="background: #1a1a1a; border-radius: 12px; border: 1px solid #333;">
                    <div class="card-body text-white">
                        <p class="card-text" style="white-space: pre-line; color: #e0e0e0;">@post.Content</p>
                        <hr style="border-top: 1px solid #333;">
                        <div class="text-end">
                            <small style="color: #666;"><i class="far fa-clock"></i> @post.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card p-4 text-center" style="background: #1a1a1a; border-radius: 12px; border: 1px solid #333;">
                <p style="color: #aaa;" class="mb-0">এখনো কোনো পোস্ট করা হয়নি। আপনার প্রথম আপডেটটি ওপরে লিখে পোস্ট করুন!</p>
            </div>
        }
    </div>
</div>