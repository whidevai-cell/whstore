@model whstore.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "WH STORE - Best Deals";
}

<!-- 🔍 সার্চ সেকশন -->
<section style="background: linear-gradient(135deg, #0d1117 0%, #161b22 50%, #0dcaf0 150%); border: 1px solid rgba(13,202,240,0.2); border-radius: 20px; padding: 50px 20px; margin-bottom: 40px; text-align: center; box-shadow: 0 8px 24px rgba(0,0,0,0.3);">
    <h1 style="color: #0dcaf0; font-size: 2.5rem; font-weight: 800; margin-bottom: 10px; tracking: 1px;">🛍️ WH A STORE</h1>
    <p style="color: rgba(255,255,255,0.8); font-size: 1.1rem; margin-bottom: 25px;">Best Deals, Lowest Prices — সেরা প্রোডাক্ট সেরা দামে!</p>

    <form asp-action="Index" method="get" style="max-width: 550px; margin: 0 auto;">
        <div style="display: flex; gap: 10px; background: #0d1117; padding: 6px; border-radius: 50px; border: 1px solid rgba(13,202,240,0.4);">
            <input type="text" name="searchString" value="@Model.CurrentFilter" placeholder="🔍 Search products..." style="flex: 1; padding: 10px 20px; border: none; font-size: 1rem; outline: none; background: transparent; color: white;" />
            <button type="submit" style="padding: 10px 28px; border-radius: 50px; border: none; background: #0dcaf0; color: #000; font-weight: 700; cursor: pointer; transition: 0.3s;">Search</button>
        </div>
    </form>
</section>

<!-- 📤 প্রোডাক্ট আপলোড সেকশন (শুধুমাত্র অথেনটিকেটেড ইউজারদের জন্য) -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <section id="upload-section" style="background: #0d1117; border: 1px solid #21262d; border-radius: 16px; padding: 25px; margin-bottom: 40px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 style="font-size: 1.3rem; color: #e6edf3; margin: 0;">📤 প্রোডাক্ট আপলোড করুন</h2>
            <button onclick="toggleUploadForm()" id="toggleBtn" style="padding: 8px 20px; background: #0dcaf0; border: none; border-radius: 25px; font-weight: 600; cursor: pointer;">➕ নতুন প্রোডাক্ট</button>
        </div>
        <div id="uploadForm" style="display: none; border-top: 1px solid #21262d; padding-top: 20px; margin-top: 20px;">
            <form asp-action="UploadProduct" asp-controller="Home" method="post" enctype="multipart/form-data">
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 15px;">
                    <input type="text" name="Title" required placeholder="Product Title" style="padding: 12px; border-radius: 8px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <input type="text" name="Price" required placeholder="Price (৳)" style="padding: 12px; border-radius: 8px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <input type="text" name="StoreName" placeholder="Store Name (e.g. AliExpress)" style="padding: 12px; border-radius: 8px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <input type="text" name="ImageUrl" placeholder="Image URL" style="padding: 12px; border-radius: 8px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <input type="url" name="AffiliateLink" required placeholder="Affiliate Link" style="padding: 12px; border-radius: 8px; background: #161b22; border: 1px solid #21262d; color: white;" />
                    <div style="grid-column: 1 / -1;">
                        <textarea name="Description" placeholder="Description..." style="width: 100%; padding: 12px; border-radius: 8px; background: #161b22; border: 1px solid #21262d; color: white; min-height: 80px;"></textarea>
                    </div>
                </div>
                <button type="submit" style="margin-top: 15px; padding: 12px 35px; background: #0dcaf0; border: none; border-radius: 50px; font-weight: 700; cursor: pointer;">🚀 আপলোড করুন</button>
            </form>
        </div>
    </section>
}

<!-- 🔥 ১. ট্রেন্ডিং প্রোডাক্টস সেকশন -->
<h2 style="color: #e6edf3; font-size: 1.5rem; margin-bottom: 20px; font-weight: 700; border-left: 4px solid #0dcaf0; padding-left: 10px;">🔥 Trending Products</h2>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-bottom: 50px;">
    @if (Model.TrendingProducts != null && Model.TrendingProducts.Any())
    {
        @foreach (var product in Model.TrendingProducts)
        {
            // 👈 HTTP এবং Protocol-Relative লিংকগুলোকে অটোমেটিক HTTPS-এ কনভার্ট করার লজিক
            var secureImgUrl = !string.IsNullOrWhiteSpace(product.ImageUrl)
            ? (product.ImageUrl.StartsWith("//") ? "https:" + product.ImageUrl : product.ImageUrl.Replace("http://", "https://"))
            : "/images/default-product.png";

            <div style="background: #0d1117; border: 1px solid #21262d; border-radius: 14px; padding: 14px; display: flex; flex-direction: column; position: relative;">

                <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" style="text-decoration: none;">
                    <div style="position: relative; overflow: hidden; border-radius: 10px;">
                        <img src="@secureImgUrl"
                             loading="lazy"
                             alt="@product.Title"
                             onerror="this.onerror=null; this.src='/images/default-product.png';"
                             style="width: 100%; height: 200px; object-fit: cover; border-radius: 10px;" />

                        @if (!string.IsNullOrEmpty(product.Category))
                        {
                            <span style="position: absolute; top: 10px; right: 10px; background: #0dcaf0; color: #000; padding: 3px 10px; border-radius: 15px; font-size: 0.75rem; font-weight: 700;">@product.Category</span>
                        }
                    </div>

                    <h3 style="color: #e6edf3; font-size: 0.95rem; margin: 12px 0 6px 0; font-weight: 600; line-height: 1.3; height: 2.6em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        @product.Title
                    </h3>
                </a>

                <div style="margin-bottom: 8px;">
                    <p style="color: #0dcaf0; font-size: 1.25rem; font-weight: 800; margin: 0;">৳@product.Price</p>
                </div>

                @if (!string.IsNullOrEmpty(product.Description))
                {
                    <p style="color: #8b949e; font-size: 0.8rem; margin: 0 0 12px 0; line-height: 1.4; height: 2.8em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        @product.Description
                    </p>
                }

                <a href="@product.AffiliateLink" target="_blank" style="display: block; padding: 10px; background: #0dcaf0; color: #000; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 700; margin-top: auto;">
                    🛒 Buy Now
                </a>
            </div>
        }
    }
    else
    {
        <p style="color: #8b949e; grid-column: 1 / -1; text-align: center; padding: 20px;">কোনো ট্রেন্ডিং প্রোডাক্ট পাওয়া যায়নি।</p>
    }
</div>

<!-- 📦 ২. আলীএক্সপ্রেস প্রোডাক্টস সেকশন -->
<h2 style="color: #e6edf3; font-size: 1.5rem; margin-bottom: 20px; font-weight: 700; border-left: 4px solid #0dcaf0; padding-left: 10px;">📦 AliExpress Products</h2>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px;">
    @if (Model.AliExpressProducts != null && Model.AliExpressProducts.Any())
    {
        @foreach (var product in Model.AliExpressProducts)
        {
            // 👈 HTTP এবং Protocol-Relative লিংকগুলোকে অটোমেটিক HTTPS-এ কনভার্ট করার লজিক
            var secureAliImgUrl = !string.IsNullOrWhiteSpace(product.ImageUrl)
            ? (product.ImageUrl.StartsWith("//") ? "https:" + product.ImageUrl : product.ImageUrl.Replace("http://", "https://"))
            : "/images/default-product.png";

            <div style="background: #0d1117; border: 1px solid #21262d; border-radius: 14px; padding: 14px; display: flex; flex-direction: column;">

                <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" style="text-decoration: none;">
                    <div style="position: relative;">
                        <img src="@secureAliImgUrl"
                             loading="lazy"
                             alt="@product.Title"
                             onerror="this.onerror=null; this.src='/images/default-product.png';"
                             style="width: 100%; height: 200px; object-fit: cover; border-radius: 10px;" />
                    </div>

                    <h3 style="color: #e6edf3; font-size: 0.95rem; margin: 12px 0 4px 0; font-weight: 600; line-height: 1.3; height: 2.6em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        @product.Title
                    </h3>
                </a>

                <p style="color: #8b949e; font-size: 0.75rem; margin: 0 0 8px 0; font-weight: 500;">📦 AliExpress</p>

                <div style="margin-bottom: 8px;">
                    <p style="color: #0dcaf0; font-size: 1.25rem; font-weight: 800; margin: 0;">৳@product.Price</p>
                </div>

                @if (!string.IsNullOrEmpty(product.Description))
                {
                    <p style="color: #8b949e; font-size: 0.8rem; margin: 0 0 12px 0; line-height: 1.4; height: 2.8em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        @product.Description
                    </p>
                }

                <a href="@product.AffiliateLink" target="_blank" style="display: block; padding: 10px; background: #0dcaf0; color: #000; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 700; margin-top: auto;">
                    🛒 Buy Now
                </a>
            </div>
        }
    }
    else
    {
        <p style="color: #8b949e; grid-column: 1 / -1; text-align: center; padding: 20px;">কোনো আলীএক্সপ্রেস প্রোডাক্ট পাওয়া যায়নি।</p>
    }
</div>

<script>
    function toggleUploadForm() {
        var form = document.getElementById('uploadForm');
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }
</script>